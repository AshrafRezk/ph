<apex:component>
    <style>
        .ev { display: flex; gap: 0.85rem; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 1.1rem; padding: 0.8rem; box-shadow: 0 4px 14px rgba(3,45,96,0.05); }
        .ev + .ev { margin-top: 0.65rem; }
        .ev--current { border-color: rgba(11,92,171,0.35); box-shadow: 0 8px 20px rgba(11,92,171,0.12); }
        .ev__day { flex: none; display: grid; place-items: center; align-content: center; width: 3.3rem; height: 3.5rem; border-radius: 0.9rem; background: linear-gradient(160deg, #032d60, #0b5cab); color: #fff; line-height: 1; }
        .ev__day b { font-size: 1.3rem; }
        .ev__day span { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; margin-top: 0.2rem; opacity: 0.85; }
        .ev__day--open { background: linear-gradient(160deg, #0d9dda, #45b0e6); }
        .ev__main { flex: 1; min-width: 0; }
        .ev__title { font-weight: 800; color: var(--brand-deep); font-size: 0.95rem; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .ev__meta { margin-top: 0.2rem; font-size: 0.78rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .ev__row { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-top: 0.45rem; }
        .ev .btn { padding: 0.45rem 0.8rem; font-size: 0.8rem; border-radius: 999px; }
    </style>

    <section class="tab" id="tab-events" data-tab="events" hidden="hidden">
        <div class="tab__head">
            <h1 class="title">Events</h1>
            <p class="sub">Your invitations and upcoming Zeta events</p>
        </div>
        <div class="section-h"><h2>My invitations</h2></div>
        <div id="myEvents"></div>
        <div class="section-h"><h2>Upcoming events</h2></div>
        <div id="openEvents"></div>
    </section>

    <script>
    window.Zeta.tabs.events = (function () {
        var Z = window.Zeta;
        var LABELS = { 'Confirmed': ['Attending', 'ok'], 'Checked In': ['Checked in', 'ok'] };
        function day(e, open) {
            return '<span class="ev__day' + (open ? ' ev__day--open' : '') + '">'
                + (e.day ? '<b>' + Z.esc(e.day.d) + '</b><span>' + Z.esc(e.day.m) + '</span>' : '<b>?</b>') + '</span>';
        }
        function meta(e) { return [e.when, e.venue].filter(Boolean).join(' · '); }
        function mine(e) {
            var label = LABELS[e.status] || ['Awaiting your reply', 'warn'];
            var action = e.current
                ? '<button type="button" class="btn btn--primary" data-pass="1">Show pass</button>'
                : '<a class="btn btn--primary" href="' + Z.esc(window.location.pathname + '?c=' + encodeURIComponent(e.code)) + '">Open</a>';
            return '<div class="ev' + (e.current ? ' ev--current' : '') + '">' + day(e) + '<div class="ev__main">'
                + '<div class="ev__title">' + Z.esc(e.title) + '</div><div class="ev__meta">' + Z.esc(meta(e)) + '</div>'
                + '<div class="ev__row"><span class="pill ' + label[1] + '">' + label[0] + '</span>' + action + '</div></div></div>';
        }
        function open(e) {
            return '<div class="ev">' + day(e, true) + '<div class="ev__main">'
                + '<div class="ev__title">' + Z.esc(e.title) + '</div><div class="ev__meta">' + Z.esc(meta(e)) + '</div>'
                + '<div class="ev__row"><span></span><button type="button" class="btn btn--soft" data-join="' + Z.esc(e.id) + '">Ask to join</button></div></div></div>';
        }
        function render() {
            var my = Z.data.events;
            document.getElementById('myEvents').innerHTML = my.length
                ? my.map(mine).join('')
                : '<p class="empty">' + (Z.data.me.known ? 'No upcoming invitations right now.' : 'Open your personal invitation link to see your invitations and entry pass here.') + '</p>';
            document.getElementById('openEvents').innerHTML = Z.data.openEvents.length
                ? Z.data.openEvents.map(open).join('')
                : '<p class="empty">New Zeta events will appear here.</p>';
            document.getElementById('tab-events').addEventListener('click', function (ev) {
                if (ev.target.closest('[data-pass]')) {
                    Z.go('home');
                    window.requestAnimationFrame(function () {
                        window.requestAnimationFrame(function () { if (Z.showPass) Z.showPass(); });
                    });
                }
                var join = ev.target.closest('[data-join]');
                if (join) Z.request('event', { eventId: join.getAttribute('data-join') });
            });
        }
        return { render: render };
    })();
    </script>
</apex:component>
