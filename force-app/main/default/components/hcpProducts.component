<apex:component>
    <style>
        .product-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 0.75rem; }
        .product-scope { flex: none; border: 0; background: #e7f1fb; color: var(--brand-deep); font-weight: 800; font-size: 0.75rem; line-height: 1.25; border-radius: 999px; padding: 0.45rem 0.72rem; cursor: pointer; max-width: 9.4rem; }
        .product-scope:active { transform: scale(0.97); }
        .product-scope[hidden] { display: none; }
        .search { display: flex; align-items: center; gap: 0.5rem; background: #fff; border: 1px solid var(--line); border-radius: 0.95rem; padding: 0 0.85rem; box-shadow: 0 4px 14px rgba(3,45,96,0.05); color: var(--muted); }
        .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; padding: 0.8rem 0; font: inherit; font-size: 0.95rem; color: #181818; }
        .filters { display: flex; gap: 0.45rem; overflow-x: auto; margin: 0.7rem -1rem 0.35rem; padding: 0 1rem 0.15rem; scrollbar-width: none; }
        .filters[hidden] { display: none; }
        .filters::-webkit-scrollbar { display: none; }
        .filter { flex: none; border: 1px solid var(--line); background: #fff; color: var(--brand-deep); border-radius: 999px; padding: 0.42rem 0.85rem; font-size: 0.82rem; font-weight: 700; cursor: pointer; }
        .filter[aria-pressed="true"] { background: var(--brand-deep); border-color: var(--brand-deep); color: #fff; }

        body.is-products { height: 100dvh; min-height: 100dvh; overflow: hidden; }
        html:has(body.is-products) { height: 100%; overflow: hidden; }
        body.is-products .wrap { height: 100%; display: flex; flex-direction: column; padding-bottom: calc(var(--bar-h) + env(safe-area-inset-bottom)); }
        body.is-products #tab-products:not([hidden]) { flex: 1; min-height: 0; display: flex; flex-direction: column; animation: none; }
        body.is-products #tab-products:not([hidden]) .tab__head { margin: 0.05rem 0 0.4rem; }
        #tab-products:not([hidden]) { display: flex; flex-direction: column; min-height: 0; }

        .helix { position: relative; flex: 1 1 auto; min-height: calc(100dvh - 18.25rem - env(safe-area-inset-bottom)); overflow: hidden; }
        .helix[hidden] { display: none; }
        .helix__index { position: absolute; z-index: 0; left: 0; top: 0; margin: 0; font-size: clamp(4.4rem, 22vw, 6.5rem); font-weight: 800; letter-spacing: -0.07em; line-height: 0.8; color: rgba(3,45,96,0.07); pointer-events: none; user-select: none; }
        .helix__stage { position: absolute; z-index: 1; inset: 0; overflow: hidden; perspective: 1200px; perspective-origin: 50% 40%; pointer-events: none; }
        .helix__dna { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
        .helix__world { position: absolute; z-index: 1; inset: 0; transform-style: preserve-3d; transform: rotateX(12deg); pointer-events: none; }
        .helix__world::before { content: ""; position: absolute; left: 50%; top: 44%; width: 9rem; height: 16rem; transform: translate(-50%, -50%); background: radial-gradient(ellipse, rgba(13,157,218,0.16), rgba(13,157,218,0) 70%); pointer-events: none; }
        .helix__fade { position: absolute; z-index: 3; inset: 0; pointer-events: none; background: linear-gradient(to bottom, rgba(244,247,251,0.97) 0%, rgba(244,247,251,0) 14%, rgba(244,247,251,0) 82%, rgba(244,247,251,0.97) 100%); }
        .helix__scroll { position: absolute; z-index: 4; inset: 0; overflow-x: hidden; overflow-y: auto; scrollbar-width: none; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; background: transparent; }
        .helix__scroll::-webkit-scrollbar { display: none; }
        .helix__rail { position: absolute; z-index: 5; right: 0.1rem; top: 14%; bottom: 16%; width: 2px; border-radius: 99px; background: rgba(3,45,96,0.1); pointer-events: none; }
        .helix__rail i { position: absolute; left: 0; top: 0; width: 2px; height: 22%; border-radius: 99px; background: var(--brand); }
        .helix__hint { position: absolute; z-index: 5; left: 50%; bottom: 0.35rem; transform: translateX(-50%); margin: 0; padding: 0.28rem 0.7rem; border-radius: 999px; background: rgba(255,255,255,0.86); color: var(--brand-deep); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; pointer-events: none; box-shadow: 0 6px 16px rgba(3,45,96,0.08); transition: opacity 0.35s ease; }
        .helix__hint[hidden] { display: none; }

        .hcard { position: absolute; left: 50%; top: 44%; width: min(8.4rem, 42vw); display: flex; flex-direction: column; margin: 0; border: 1px solid var(--line); background: rgba(255,255,255,0.94); border-radius: 1.15rem; padding: 0.45rem 0.45rem 0.6rem; text-align: left; cursor: pointer; transform-origin: center center; backface-visibility: hidden; pointer-events: auto; box-shadow: 0 calc(8px + var(--lift, 0) * 22px) calc(18px + var(--lift, 0) * 28px) rgba(3,45,96, calc(0.05 + var(--lift, 0) * 0.16)); }
        .hcard .pcard__img { display: grid; place-items: center; aspect-ratio: 1.02; border-radius: 0.85rem; background: linear-gradient(180deg, #f7fafd, #eef3f9); overflow: hidden; }
        .hcard .pcard__img img { max-width: 88%; max-height: 88%; object-fit: contain; }
        .hcard .pcard__ph { font-size: 1.6rem; font-weight: 800; color: #b9c7da; }
        .hcard b { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 0.5rem; font-size: 0.86rem; color: var(--brand-deep); line-height: 1.25; }
        .hcard span { margin-top: 0.12rem; font-size: 0.72rem; color: var(--muted); }

        .pd__img { display: grid; place-items: center; height: 12rem; border-radius: 1.1rem; background: linear-gradient(180deg, #f7fafd, #eef3f9); margin: 0.4rem 0 1rem; clear: both; }
        .pd__img img { display: block; width: auto; height: auto; max-width: 85%; max-height: 10.5rem; object-fit: contain; }
        .pd h2 { margin: 0 0 0.35rem; color: var(--brand-deep); font-size: 1.35rem; }
        .pd__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.9rem; }
        .pd__text { color: #374151; font-size: 0.94rem; line-height: 1.55; }
        .pd__text p { margin: 0 0 0.7rem; }
        .pd__actions { display: grid; gap: 0.55rem; margin-top: 1.1rem; }
        .pd__fine { margin-top: 0.9rem; font-size: 0.75rem; color: var(--muted); text-align: center; }

        @media (prefers-reduced-motion: reduce) {
            .helix__scroll, .helix__index, .helix__rail, .helix__hint, .helix__fade, .helix__dna { display: none; }
            .helix__stage { overflow: auto; perspective: none; pointer-events: auto; }
            .helix__world { position: static; height: auto; transform: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; padding: 0.2rem 0 1.2rem; }
            .helix__world::before { display: none; }
            .hcard { position: static; width: auto; left: auto; top: auto; opacity: 1 !important; visibility: visible !important; transform: none !important; }
        }
    </style>

    <section class="tab" id="tab-products" data-tab="products" hidden="hidden">
        <div class="tab__head product-head">
            <div>
                <h1 class="title">Products</h1>
                <p class="sub" id="productSub">Rated for you</p>
            </div>
            <button type="button" class="product-scope" id="productScope">Show all portfolio</button>
        </div>
        <label class="search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
            <input id="productSearch" type="search" placeholder="Search brands" autocomplete="off" />
        </label>
        <div class="filters" id="productAreas"></div>
        <div class="helix" id="productHelix">
            <div class="helix__index" id="productIndex" aria-hidden="true">01</div>
            <div class="helix__stage">
                <canvas class="helix__dna" id="productDna" aria-hidden="true"></canvas>
                <div class="helix__world" id="productWorld"></div>
            </div>
            <div class="helix__fade" aria-hidden="true"></div>
            <div class="helix__scroll" id="productScroll" tabindex="0" aria-label="Scroll through products">
                <div id="productTrack"></div>
            </div>
            <div class="helix__rail" aria-hidden="true"><i id="productRail"></i></div>
            <p class="helix__hint" id="productHint">Tap a brand</p>
        </div>
        <p class="empty" id="productEmpty" hidden="hidden">No products match your search.</p>
    </section>

    <script>
    window.Zeta.tabs.products = (function () {
        var Z = window.Zeta;
        var area = 'All';
        var query = '';
        var showAll = false;
        var openBrand = null;
        var needsReset = true;
        var spread = 96;
        var current = 0;
        var target = 0;
        var running = false;
        var holding = false;
        var dragged = false;
        var originX = 0;
        var originY = 0;
        var settleTimer = 0;
        var spin = 0;
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var TURN = 6;

        function initials(name) { return String(name || '?').slice(0, 2).toUpperCase(); }
        function pad(n) { return (n < 10 ? '0' : '') + n; }
        function world() { return document.getElementById('productWorld'); }
        function scroller() { return document.getElementById('productScroll'); }

        function catalogue() { return Z.data.products || []; }
        function isDetail(p) { return !!(p && p.kind === 'detail'); }
        function childrenOf(id) {
            var out = [];
            catalogue().forEach(function (p) {
                if (isDetail(p) && p.brandId === id) out.push(p);
            });
            return out;
        }
        function brands() {
            return catalogue().filter(function (p) { return !isDetail(p); });
        }
        function sourceRows() {
            if (openBrand) return childrenOf(openBrand);
            return brands().filter(function (p) { return showAll || p.rated; });
        }
        function facet(p) {
            return openBrand ? (p.form || 'Other') : (p.area || 'Other');
        }
        function matches(p) {
            if (area !== 'All' && facet(p) !== area) return false;
            if (!query) return true;
            return (p.name + ' ' + (p.area || '') + ' ' + (p.strength || '') + ' ' + (p.form || '') + ' ' + (p.description || '')).toLowerCase().indexOf(query.toLowerCase()) !== -1;
        }
        function caption(p) {
            if (isDetail(p)) return [p.strength, p.form].filter(Boolean).join(' · ') || p.area || '';
            var n = childrenOf(p.id).length;
            var bits = [];
            if (p.area) bits.push(p.area);
            if (n) bits.push(n + (n === 1 ? ' product' : ' products'));
            return bits.join(' · ');
        }
        function card(p, i) {
            var img = p.image
                ? '<img alt="" data-ph="' + Z.esc(initials(p.name)) + '" src="' + Z.esc(p.image) + '"/>'
                : '<span class="pcard__ph">' + Z.esc(initials(p.name)) + '</span>';
            return '<button type="button" class="hcard" data-product="' + Z.esc(p.id) + '" data-i="' + i + '">'
                + '<span class="pcard__img">' + img + '</span>'
                + '<b>' + Z.esc(p.name) + '</b><span>' + Z.esc(caption(p)) + '</span></button>';
        }
        function paintCopy() {
            var sub = document.getElementById('productSub');
            var btn = document.getElementById('productScope');
            var search = document.getElementById('productSearch');
            if (openBrand) {
                var brand = Z.product(openBrand);
                var count = childrenOf(openBrand).length;
                sub.textContent = (brand ? brand.name : 'Brand') + ' · ' + count + (count === 1 ? ' product' : ' products');
                btn.hidden = false;
                btn.textContent = 'All brands';
                if (search) search.placeholder = 'Search this brand';
                return;
            }
            if (search) search.placeholder = 'Search brands';
            var list = brands();
            var anyRated = list.some(function (p) { return p.rated; });
            if (!list.length) {
                btn.hidden = true;
                sub.textContent = 'The Zeta Pharma portfolio';
                return;
            }
            btn.hidden = false;
            if (showAll) {
                sub.textContent = 'The Zeta Pharma portfolio';
                btn.textContent = 'Show my products';
            } else {
                sub.textContent = anyRated ? 'Rated for you' : 'Nothing rated for you yet';
                btn.textContent = 'Show all portfolio';
            }
        }
        function paintAreas(rows) {
            var areas = {};
            rows.forEach(function (p) {
                var value = facet(p);
                if (value) areas[value] = true;
            });
            var list = ['All'].concat(Object.keys(areas).sort(function (a, b) {
                return a === 'Other' ? 1 : b === 'Other' ? -1 : a.localeCompare(b);
            }));
            var host = document.getElementById('productAreas');
            var key = list.join('|');
            if (host.getAttribute('data-key') !== key) {
                if (list.indexOf(area) === -1) area = 'All';
                host.setAttribute('data-key', key);
                host.innerHTML = list.map(function (a) {
                    return '<button type="button" class="filter" data-area="' + Z.esc(a) + '">' + Z.esc(a) + '</button>';
                }).join('');
                host.hidden = list.length < 2 || (openBrand && Object.keys(areas).length < 2);
            }
            host.querySelectorAll('.filter').forEach(function (b) {
                b.setAttribute('aria-pressed', b.getAttribute('data-area') === area ? 'true' : 'false');
            });
        }
        function draw() {
            paintCopy();
            var scoped = sourceRows();
            paintAreas(scoped);
            var rows = scoped.filter(matches);
            world().innerHTML = rows.map(card).join('');
            var empty = document.getElementById('productEmpty');
            var helix = document.getElementById('productHelix');
            helix.hidden = rows.length === 0;
            empty.hidden = rows.length !== 0;
            if (!rows.length) {
                if (!brands().length && !openBrand) empty.textContent = 'Our product catalogue is coming soon.';
                else if (!scoped.length && !openBrand) empty.textContent = 'No products are rated for you yet.';
                else if (openBrand && !scoped.length) empty.textContent = 'This brand has no products in the catalogue yet.';
                else empty.textContent = 'No products match your search.';
            }
            var hint = document.getElementById('productHint');
            if (hint) hint.textContent = openBrand ? 'Tap a product' : 'Tap a brand';
            document.getElementById('productTrack').setAttribute('data-key', '');
            var tab = document.getElementById('tab-products');
            if (tab && !tab.hidden) layout(true);
            else needsReset = true;
        }
        function layout(reset) {
            if (reduce) return;
            var scroll = scroller();
            var cards = world().querySelectorAll('.hcard');
            var n = cards.length;
            var h = scroll.clientHeight;
            if (h < 40 || !n) return;
            spread = Math.max(84, Math.min(118, Math.round(h * 0.22)));
            var host = document.getElementById('productTrack');
            var key = n + ':' + spread + ':' + h;
            if (host.getAttribute('data-key') !== key) {
                var prev = reset ? 0 : scroll.scrollTop;
                var html = '';
                for (var i = 0; i < n; i++) html += '<div class="helix__stop" style="height:' + spread + 'px"></div>';
                html += '<div style="height:' + Math.max(0, h - spread) + 'px"></div>';
                host.innerHTML = html;
                host.setAttribute('data-key', key);
                scroll.scrollTop = Math.min(Math.max(0, prev), Math.max(0, (n - 1) * spread));
            } else if (reset) {
                scroll.scrollTop = 0;
            }
            target = scroll.scrollTop / spread;
            if (reset) current = target;
            kick();
        }
        function kick() {
            if (reduce || running) return;
            running = true;
            window.requestAnimationFrame(step);
        }
        function productsOpen() {
            var tab = document.getElementById('tab-products');
            return !!(tab && !tab.hidden);
        }
        function step() {
            if (!productsOpen()) {
                running = false;
                return;
            }
            spin += 0.012;
            var delta = target - current;
            if (Math.abs(delta) > 0.0008) current += delta * 0.085;
            else current = target;
            place();
            window.requestAnimationFrame(step);
        }
        function drawDna(w, h) {
            var canvas = document.getElementById('productDna');
            if (!canvas || reduce) return;
            var dpr = Math.min(window.devicePixelRatio || 1, 2);
            var pw = Math.floor(w * dpr);
            var ph = Math.floor(h * dpr);
            if (canvas.width !== pw || canvas.height !== ph) {
                canvas.width = pw;
                canvas.height = ph;
            }
            var ctx = canvas.getContext('2d');
            if (!ctx) return;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.clearRect(0, 0, w, h);
            var cx = w * 0.5;
            var cy = h * 0.44;
            var dnaR = Math.max(34, Math.min(54, w * 0.145));
            var phase = -current * ((Math.PI * 2) / TURN) + spin;
            var span = h * 0.96;
            var steps = 80;
            var strandA = [];
            var strandB = [];
            var i;
            for (i = 0; i <= steps; i++) {
                var u = i / steps;
                var y = (u - 0.5) * span;
                var ang = phase + u * Math.PI * 2 * 3.1;
                strandA.push({ x: cx + Math.sin(ang) * dnaR, y: cy + y, z: Math.cos(ang) });
                strandB.push({ x: cx + Math.sin(ang + Math.PI) * dnaR, y: cy + y, z: Math.cos(ang + Math.PI) });
            }
            for (i = 0; i < strandA.length; i += 4) {
                var a = strandA[i];
                var b = strandB[i];
                var front = Math.max(a.z, b.z);
                ctx.strokeStyle = 'rgba(3,45,96,' + (0.08 + (front + 1) * 0.14).toFixed(3) + ')';
                ctx.lineWidth = 1.4;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.stroke();
            }
            var segs = [];
            function pushStrand(pts, rgb) {
                var s;
                for (s = 1; s < pts.length; s++) {
                    segs.push({ a: pts[s - 1], b: pts[s], z: (pts[s - 1].z + pts[s].z) / 2, rgb: rgb });
                }
            }
            pushStrand(strandA, '11,92,171');
            pushStrand(strandB, '13,157,218');
            segs.sort(function (p, q) { return p.z - q.z; });
            segs.forEach(function (s) {
                var alpha = 0.16 + (s.z + 1) / 2 * 0.84;
                ctx.strokeStyle = 'rgba(' + s.rgb + ',' + alpha.toFixed(3) + ')';
                ctx.lineWidth = 1.8 + (s.z + 1) * 1.7;
                ctx.lineCap = 'round';
                ctx.beginPath();
                ctx.moveTo(s.a.x, s.a.y);
                ctx.lineTo(s.b.x, s.b.y);
                ctx.stroke();
            });
            function beads(pts, rgb) {
                var b;
                for (b = 0; b < pts.length; b += 4) {
                    var p = pts[b];
                    var alpha = 0.28 + (p.z + 1) / 2 * 0.72;
                    ctx.fillStyle = 'rgba(' + rgb + ',' + alpha.toFixed(3) + ')';
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, 2.1 + (p.z + 1) * 1.15, 0, Math.PI * 2);
                    ctx.fill();
                }
            }
            beads(strandA, '11,92,171');
            beads(strandB, '13,157,218');
        }
        function place() {
            var scroll = scroller();
            var stage = scroll.parentElement;
            var w = (stage && stage.clientWidth) || scroll.clientWidth || 320;
            var h = (stage && stage.clientHeight) || scroll.clientHeight || 480;
            drawDna(w, h);
            var cards = world().querySelectorAll('.hcard');
            var n = cards.length;
            if (!n) return;
            var radius = Math.max(108, Math.min(156, w * 0.4));
            var angleStep = (Math.PI * 2) / TURN;
            for (var i = 0; i < n; i++) {
                var el = cards[i];
                var t = i - current;
                if (Math.abs(t) > 4.5) {
                    el.style.visibility = 'hidden';
                    el.style.opacity = '0';
                    continue;
                }
                var angle = t * angleStep;
                var x = Math.sin(angle) * radius;
                var z = Math.cos(angle) * radius * 0.78;
                var y = t * spread * 0.56;
                var focus = Math.exp(-(t * t) / 2.55);
                var depth = (z / (radius * 0.78) + 1) / 2;
                var scale = 0.7 + focus * 0.44;
                var opacity = Math.max(0, Math.min(1, (0.05 + focus * 0.95) * (0.28 + depth * 0.72)));
                var yaw = Math.sin(angle) * -32;
                el.style.visibility = opacity < 0.045 ? 'hidden' : 'visible';
                el.style.opacity = opacity.toFixed(3);
                el.style.zIndex = String(200 + Math.round(z));
                el.style.transform = 'translate(-50%, -50%) translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,' + z.toFixed(1) + 'px) rotateY(' + yaw.toFixed(2) + 'deg) scale(' + scale.toFixed(3) + ')';
                el.style.setProperty('--lift', focus.toFixed(3));
            }
            var shown = Math.max(0, Math.min(n - 1, Math.round(current)));
            var indexEl = document.getElementById('productIndex');
            var rail = document.getElementById('productRail');
            var hint = document.getElementById('productHint');
            if (indexEl) indexEl.textContent = pad(shown + 1);
            if (rail) rail.style.top = ((n < 2 ? 0 : current / (n - 1)) * 78) + '%';
            if (hint) {
                hint.hidden = n < 2;
                hint.style.opacity = current > 0.35 ? '0' : '1';
            }
        }
        function armSettle() {
            window.clearTimeout(settleTimer);
            if (reduce) return;
            settleTimer = window.setTimeout(function () {
                if (holding) return;
                var scroll = scroller();
                var n = world().querySelectorAll('.hcard').length;
                if (n < 2 || !spread) return;
                var max = (n - 1) * spread;
                var nearest = Math.max(0, Math.min(max, Math.round(scroll.scrollTop / spread) * spread));
                if (Math.abs(scroll.scrollTop - nearest) < 1) return;
                scroll.scrollTo({ top: nearest, behavior: 'smooth' });
            }, 180);
        }
        function activate(id) {
            var p = Z.product(id);
            if (!p) return;
            if (!isDetail(p) && childrenOf(p.id).length) {
                openBrand = p.id;
                area = 'All';
                query = '';
                var search = document.getElementById('productSearch');
                if (search) search.value = '';
                document.getElementById('productAreas').setAttribute('data-key', '');
                draw();
                return;
            }
            open(id);
        }
        function open(id) {
            var p = Z.product(id);
            if (!p) return;
            var meta = [p.area, p.strength, p.form].filter(Boolean).map(function (m) { return '<span class="pill">' + Z.esc(m) + '</span>'; }).join('');
            Z.sheet('<div class="pd">'
                + '<div class="pd__img">' + (p.image ? '<img alt="" src="' + Z.esc(p.image) + '"/>' : '<span class="pcard__ph">' + Z.esc(initials(p.name)) + '</span>') + '</div>'
                + '<h2>' + Z.esc(p.name) + '</h2><div class="pd__meta">' + meta + '</div>'
                + '<div class="pd__text">' + (p.description ? Z.paragraphs(p.description) : '<p>Ask your Zeta representative or our Medical Affairs team for full prescribing information.</p>') + '</div>'
                + '<div class="pd__actions">'
                + '<button type="button" class="btn btn--primary btn--block" data-ask="samples" data-id="' + Z.esc(p.id) + '">Request samples</button>'
                + '<button type="button" class="btn btn--soft btn--block" data-ask="medical" data-id="' + Z.esc(p.id) + '">Ask a medical question</button>'
                + '<button type="button" class="btn btn--soft btn--block" data-ask="material" data-id="' + Z.esc(p.id) + '">Request scientific material</button>'
                + '</div><p class="pd__fine">For healthcare professionals only. Please refer to the approved prescribing information.</p></div>');
        }
        function show() {
            document.body.classList.add('is-products');
            window.requestAnimationFrame(function () {
                layout(needsReset);
                needsReset = false;
                window.requestAnimationFrame(function () {
                    if (scroller().clientHeight < 40) layout(false);
                });
            });
        }
        function render() {
            document.getElementById('productAreas').addEventListener('click', function (e) {
                var b = e.target.closest('.filter');
                if (!b) return;
                area = b.getAttribute('data-area');
                draw();
            });
            document.getElementById('productSearch').addEventListener('input', function (e) {
                query = e.target.value.trim();
                draw();
            });
            document.getElementById('productScope').addEventListener('click', function () {
                area = 'All';
                query = '';
                document.getElementById('productSearch').value = '';
                document.getElementById('productAreas').setAttribute('data-key', '');
                if (openBrand) {
                    openBrand = null;
                    draw();
                    return;
                }
                showAll = !showAll;
                draw();
            });
            world().addEventListener('error', function (e) {
                var img = e.target;
                if (!img || img.tagName !== 'IMG') return;
                var ph = document.createElement('span');
                ph.className = 'pcard__ph';
                ph.textContent = img.getAttribute('data-ph') || '';
                img.replaceWith(ph);
            }, true);
            var scroll = scroller();
            scroll.addEventListener('scroll', function () {
                target = scroll.scrollTop / spread;
                kick();
                armSettle();
            }, { passive: true });
            scroll.addEventListener('pointerdown', function (e) {
                holding = true;
                dragged = false;
                originX = e.clientX;
                originY = e.clientY;
                window.clearTimeout(settleTimer);
            });
            scroll.addEventListener('pointermove', function (e) {
                if (Math.abs(e.clientX - originX) > 8 || Math.abs(e.clientY - originY) > 8) dragged = true;
            });
            scroll.addEventListener('pointerup', function () { holding = false; armSettle(); });
            scroll.addEventListener('pointercancel', function () { holding = false; });
            function cardAt(x, y) {
                var cards = world().querySelectorAll('.hcard');
                var best = null;
                var bestZ = -1e9;
                for (var i = 0; i < cards.length; i++) {
                    var rect = cards[i].getBoundingClientRect();
                    if (x < rect.left || x > rect.right || y < rect.top || y > rect.bottom) continue;
                    var z = parseFloat(cards[i].style.zIndex || '0');
                    if (z >= bestZ) {
                        bestZ = z;
                        best = cards[i];
                    }
                }
                return best;
            }
            scroll.addEventListener('click', function (e) {
                if (dragged || reduce) return;
                var tile = cardAt(e.clientX, e.clientY);
                if (!tile) return;
                var index = +tile.getAttribute('data-i');
                if (index !== Math.round(current)) {
                    scroll.scrollTo({ top: index * spread, behavior: 'smooth' });
                    return;
                }
                activate(tile.getAttribute('data-product'));
            });
            scroll.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                    e.preventDefault();
                    scroll.scrollBy({ top: (e.key === 'ArrowDown' ? 1 : -1) * spread, behavior: 'smooth' });
                } else if (e.key === 'Enter') {
                    var focal = world().querySelectorAll('.hcard')[Math.round(current)];
                    if (focal) activate(focal.getAttribute('data-product'));
                }
            });
            document.addEventListener('click', function (e) {
                var tile = e.target.closest('[data-product]');
                if (tile && reduce) { activate(tile.getAttribute('data-product')); return; }
                var ask = e.target.closest('[data-ask]');
                if (ask) Z.request(ask.getAttribute('data-ask'), { productId: ask.getAttribute('data-id') });
            });
            document.addEventListener('zeta:tab', function (e) {
                if (e.detail !== 'products') {
                    document.body.classList.remove('is-products');
                    running = false;
                }
            });
            window.addEventListener('resize', function () {
                if (productsOpen()) layout(false);
            });
            if (window.ResizeObserver) {
                new ResizeObserver(function () {
                    if (productsOpen()) layout(false);
                }).observe(document.getElementById('productHelix'));
            }
            draw();
        }
        return { render: render, open: open, show: show };
    })();
    </script>
</apex:component>
