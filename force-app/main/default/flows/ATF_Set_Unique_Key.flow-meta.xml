<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <assignments>
        <name>Set_ATF_Values</name>
        <label>Set ATF Values</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <assignmentItems>
            <assignToReference>$Record.Unique_Key__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>UniqueKeyFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Matrix_Rating__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>MatrixRatingFormula</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Classification__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>ClassificationFormula</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <description>Sets Unique_Key__c, Matrix_Rating__c, and Classification__c before save.</description>
    <environments>Default</environments>
    <formulas>
        <name>ClassificationFormula</name>
        <dataType>String</dataType>
        <expression>CASE(
  UPPER({!MatrixRatingFormula}),
  &quot;A1&quot;, &quot;A&quot;,
  &quot;A2&quot;, &quot;A&quot;,
  &quot;B1&quot;, &quot;A&quot;,
  &quot;A3&quot;, &quot;B&quot;,
  &quot;B2&quot;, &quot;B&quot;,
  &quot;C1&quot;, &quot;B&quot;,
  &quot;B3&quot;, &quot;C&quot;,
  &quot;C2&quot;, &quot;C&quot;,
  &quot;C3&quot;, &quot;C&quot;,
  &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>MatrixRatingFormula</name>
        <dataType>String</dataType>
        <expression>LOWER(TEXT({!$Record.Potential__c}) &amp; TEXT({!$Record.Penetration__c}))</expression>
    </formulas>
    <formulas>
        <name>UniqueKeyFormula</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account__c} &amp; &quot;:&quot; &amp; {!$Record.Territory2_Id__c}</expression>
    </formulas>
    <interviewLabel>ATF Set Unique Key {!$Flow.CurrentDateTime}</interviewLabel>
    <label>ATF Set Unique Key</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_ATF_Values</targetReference>
        </connector>
        <object>Account_Territory_Fields__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
