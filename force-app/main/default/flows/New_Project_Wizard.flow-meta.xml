            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Project_Lead__c</field>
            <value>
                <elementReference>Project_Lead.recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Start_Date__c</field>
            <value>
                <elementReference>Start_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
