            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Total_Budget__c</field>
            <value>
                <elementReference>Total_Budget</elementReference>
            </value>
        </inputAssignments>
        <object>Pharma_Project__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
