<apex:page controller="ProductSurveyController" showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false" docType="html-5.0">
    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
            <meta name="theme-color" content="#0a0a12" media="(prefers-color-scheme: dark)" />
            <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)" />
            <meta name="apple-mobile-web-app-capable" content="yes" />
            <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
            <title>Doctor Feedback — Chemipharm</title>
            <style>
                :root {
                    --bg-base: #f2f2f7;
                    --bg-elevated: rgba(255, 255, 255, 0.72);
                    --bg-glass: rgba(255, 255, 255, 0.55);
                    --bg-glass-strong: rgba(255, 255, 255, 0.82);
                    --bg-card: rgba(255, 255, 255, 0.78);
                    --bg-hero: linear-gradient(165deg, #e8ecf8 0%, #f5f0ff 45%, #eef6ff 100%);
                    --text-primary: #1c1c1e;
                    --text-secondary: rgba(60, 60, 67, 0.72);
                    --text-tertiary: rgba(60, 60, 67, 0.48);
                    --accent: #5856d6;
                    --accent-light: #7b79e8;
                    --accent-glow: rgba(88, 86, 214, 0.35);
                    --positive: #34c759;
                    --positive-bg: rgba(52, 199, 89, 0.14);
                    --positive-glow: rgba(52, 199, 89, 0.3);
                    --neutral: #ff9f0a;
                    --neutral-bg: rgba(255, 159, 10, 0.14);
                    --neutral-glow: rgba(255, 159, 10, 0.28);
                    --negative: #ff3b30;
                    --negative-bg: rgba(255, 59, 48, 0.12);
                    --negative-glow: rgba(255, 59, 48, 0.28);
                    --border: rgba(0, 0, 0, 0.06);
                    --border-strong: rgba(0, 0, 0, 0.1);
                    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02);
                    --shadow-md: 0 4px 24px rgba(0, 0, 0, 0.06), 0 2px 8px rgba(0, 0, 0, 0.04);
                    --shadow-lg: 0 12px 40px rgba(0, 0, 0, 0.1), 0 4px 12px rgba(0, 0, 0, 0.05);
                    --shadow-glow: 0 8px 32px var(--accent-glow);
                    --radius-sm: 12px;
                    --radius-md: 18px;
                    --radius-lg: 22px;
                    --radius-xl: 28px;
                    --tap-min: 3rem;
                    --spring: cubic-bezier(0.34, 1.56, 0.64, 1);
                    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
                    --header-h: 3.75rem;
                }

                @media (prefers-color-scheme: dark) {
                    :root {
                        --bg-base: #000000;
                        --bg-elevated: rgba(28, 28, 30, 0.78);
                        --bg-glass: rgba(28, 28, 30, 0.62);
                        --bg-glass-strong: rgba(28, 28, 30, 0.88);
                        --bg-card: rgba(44, 44, 46, 0.72);
                        --bg-hero: linear-gradient(165deg, #1a1a2e 0%, #16213e 45%, #0f3460 100%);
                        --text-primary: #f5f5f7;
                        --text-secondary: rgba(235, 235, 245, 0.68);
                        --text-tertiary: rgba(235, 235, 245, 0.42);
                        --accent: #7d7aff;
                        --accent-light: #9896ff;
                        --accent-glow: rgba(125, 122, 255, 0.4);
                        --positive-bg: rgba(48, 209, 88, 0.18);
                        --positive-glow: rgba(48, 209, 88, 0.35);
                        --neutral-bg: rgba(255, 159, 10, 0.2);
                        --neutral-glow: rgba(255, 159, 10, 0.32);
                        --negative-bg: rgba(255, 69, 58, 0.18);
                        --negative-glow: rgba(255, 69, 58, 0.32);
                        --border: rgba(255, 255, 255, 0.08);
                        --border-strong: rgba(255, 255, 255, 0.14);
                        --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
                        --shadow-md: 0 4px 24px rgba(0, 0, 0, 0.4);
                        --shadow-lg: 0 12px 40px rgba(0, 0, 0, 0.5);
                    }
                }

                *, *::before, *::after { box-sizing: border-box; }
                html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
                body {
                    margin: 0;
                    min-height: 100dvh;
                    background: var(--bg-base);
                    color: var(--text-primary);
                    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", Arial, sans-serif;
                    font-size: 1rem;
                    line-height: 1.47;
                    letter-spacing: -0.01em;
                    -webkit-font-smoothing: antialiased;
                    -moz-osx-font-smoothing: grayscale;
                }

                /* Ambient background orbs */
                body::before,
                body::after {
                    content: "";
                    position: fixed;
                    border-radius: 50%;
                    pointer-events: none;
                    z-index: 0;
                    filter: blur(80px);
                    opacity: 0.5;
                }
                body::before {
                    top: -8rem;
                    right: -6rem;
                    width: 18rem;
                    height: 18rem;
                    background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
                }
                body::after {
                    bottom: 20%;
                    left: -8rem;
                    width: 16rem;
                    height: 16rem;
                    background: radial-gradient(circle, rgba(52, 199, 89, 0.15) 0%, transparent 70%);
                }

                /* ── Frosted glass header ── */
                .app-header {
                    position: sticky;
                    top: 0;
                    z-index: 200;
                    padding: calc(0.625rem + env(safe-area-inset-top)) 1.125rem 0.75rem;
                    background: var(--bg-glass-strong);
                    backdrop-filter: saturate(180%) blur(20px);
                    -webkit-backdrop-filter: saturate(180%) blur(20px);
                    border-bottom: 0.5px solid var(--border);
                }
                .app-header-inner {
                    max-width: 28rem;
                    margin: 0 auto;
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                }
                .brand-logo {
                    flex-shrink: 0;
                    height: 2rem;
                    width: auto;
                    max-width: 5.5rem;
                    object-fit: contain;
                    object-position: left center;
                    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.08));
                }
                .app-header-text .eyebrow {
                    font-size: 0.625rem;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    color: var(--text-tertiary);
                    font-weight: 600;
                }
                .app-header-text h1 {
                    margin: 0;
                    font-size: 1.125rem;
                    font-weight: 700;
                    letter-spacing: -0.03em;
                    line-height: 1.15;
                    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent) 120%);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }

                /* ── Shell ── */
                .app-shell {
                    position: relative;
                    z-index: 1;
                    max-width: 28rem;
                    margin: 0 auto;
                    padding: 1rem 1rem calc(6.5rem + env(safe-area-inset-bottom));
                    animation: fade-up 0.6s var(--ease-out) both;
                }
                @keyframes fade-up {
                    from { opacity: 0; transform: translateY(16px); }
                    to { opacity: 1; transform: translateY(0); }
                }

                /* ── Product hero ── */
                .product-hero {
                    position: relative;
                    background: var(--bg-card);
                    border: 0.5px solid var(--border);
                    border-radius: var(--radius-lg);
                    box-shadow: var(--shadow-md);
                    overflow: hidden;
                    margin-bottom: 1rem;
                    backdrop-filter: blur(16px);
                    -webkit-backdrop-filter: blur(16px);
                }
                .product-hero-media {
                    position: relative;
                    background: var(--bg-hero);
                    min-height: 11rem;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 1.75rem 1.5rem 2.5rem;
                    overflow: hidden;
                }
                .product-hero-media::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: radial-gradient(ellipse 80% 60% at 50% 100%, rgba(255,255,255,0.35) 0%, transparent 70%);
                    pointer-events: none;
                }
                .product-hero-media::after {
                    content: "";
                    position: absolute;
                    bottom: 0;
                    left: 10%;
                    right: 10%;
                    height: 40%;
                    background: linear-gradient(to bottom, transparent, rgba(0,0,0,0.03));
                    transform: scaleY(-1);
                    opacity: 0.4;
                    pointer-events: none;
                }
                .product-hero-img-wrap {
                    position: relative;
                    z-index: 1;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                }
                .product-hero-media img {
                    max-width: 100%;
                    max-height: 10.5rem;
                    object-fit: contain;
                    filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.15));
                    transition: transform 0.5s var(--ease-out);
                }
                .product-hero-reflection {
                    width: 70%;
                    height: 2.5rem;
                    margin-top: -0.25rem;
                    background: linear-gradient(to bottom, rgba(0,0,0,0.06), transparent);
                    transform: scaleY(-1);
                    mask-image: linear-gradient(to bottom, rgba(0,0,0,0.25), transparent);
                    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.25), transparent);
                    opacity: 0.5;
                    pointer-events: none;
                }
                .product-hero-avatar {
                    position: relative;
                    z-index: 1;
                    width: 5.5rem;
                    height: 5.5rem;
                    border-radius: 50%;
                    background: linear-gradient(145deg, var(--accent) 0%, #af52de 100%);
                    color: #fff;
                    font-size: 1.375rem;
                    font-weight: 700;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    letter-spacing: 0.04em;
                    box-shadow: var(--shadow-glow);
                }
                .product-hero-body {
                    padding: 1.125rem 1.25rem 1.375rem;
                }
                .product-hero-body h2 {
                    margin: 0 0 0.375rem;
                    font-size: 1.375rem;
                    font-weight: 700;
                    letter-spacing: -0.03em;
                    line-height: 1.2;
                }
                .product-hero-body .subtitle {
                    margin: 0;
                    color: var(--text-secondary);
                    font-size: 0.9375rem;
                    line-height: 1.45;
                    font-weight: 400;
                }
                .meta-row {
                    display: flex;
                    flex-wrap: wrap;
                    gap: 0.5rem;
                    margin-top: 0.875rem;
                }
                .pill-badge {
                    display: inline-flex;
                    align-items: center;
                    padding: 0.3125rem 0.75rem;
                    border-radius: 999px;
                    font-size: 0.75rem;
                    font-weight: 600;
                    letter-spacing: -0.01em;
                    line-height: 1.3;
                }
                .pill-badge_accent {
                    background: rgba(88, 86, 214, 0.12);
                    color: var(--accent);
                }
                @media (prefers-color-scheme: dark) {
                    .pill-badge_accent {
                        background: rgba(125, 122, 255, 0.2);
                        color: var(--accent-light);
                    }
                }
                .pill-badge_neutral {
                    background: var(--neutral-bg);
                    color: var(--text-secondary);
                }

                /* ── Glass cards ── */
                .glass-card {
                    background: var(--bg-card);
                    border: 0.5px solid var(--border);
                    border-radius: var(--radius-lg);
                    padding: 1.25rem;
                    margin-bottom: 1rem;
                    box-shadow: var(--shadow-sm);
                    backdrop-filter: blur(16px);
                    -webkit-backdrop-filter: blur(16px);
                    animation: fade-up 0.6s var(--ease-out) both;
                }
                .glass-card:nth-child(2) { animation-delay: 0.08s; }
                .glass-card:nth-child(3) { animation-delay: 0.16s; }
                .glass-card__header {
                    margin: 0 0 0.875rem;
                }
                .glass-card__title {
                    margin: 0;
                    font-size: 0.8125rem;
                    font-weight: 700;
                    letter-spacing: -0.01em;
                    color: var(--text-secondary);
                    text-transform: none;
                }
                .glass-card__subtitle {
                    margin: 0.25rem 0 0;
                    font-size: 0.75rem;
                    color: var(--text-tertiary);
                }

                /* ── Sentiment segmented control ── */
                .rating-topic {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 0.75rem;
                    padding: 0.6875rem 0;
                    border-bottom: 0.5px solid var(--border);
                    animation: fade-up 0.5s var(--ease-out) both;
                }
                .rating-topic:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                }
                .rating-topic:first-child { padding-top: 0; }
                .rating-label {
                    flex: 1;
                    min-width: 0;
                    font-size: 0.9375rem;
                    font-weight: 600;
                    letter-spacing: -0.02em;
                    color: var(--text-primary);
                    line-height: 1.25;
                }
                .sentiment-segment {
                    flex-shrink: 0;
                    padding: 3px;
                    border-radius: 11px;
                    background: rgba(120, 120, 128, 0.12);
                    border: 0.5px solid var(--border);
                    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.04);
                    backdrop-filter: blur(8px);
                    -webkit-backdrop-filter: blur(8px);
                }
                @media (prefers-color-scheme: dark) {
                    .sentiment-segment {
                        background: rgba(120, 120, 128, 0.24);
                    }
                }
                .sentiment-row {
                    display: flex;
                    align-items: stretch;
                    gap: 2px;
                }
                .sentiment-row table,
                .sentiment-row tbody,
                .sentiment-row tr { display: flex; gap: 2px; }
                .sentiment-row td { display: flex; }
                .sentiment-row input[type="radio"] {
                    position: absolute;
                    opacity: 0;
                    width: 0;
                    height: 0;
                    pointer-events: none;
                }
                .sentiment-row label {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    min-width: 2.75rem;
                    min-height: 2.25rem;
                    padding: 0.4375rem 0.625rem;
                    border: none;
                    border-radius: 8px;
                    background: transparent;
                    color: var(--text-tertiary);
                    cursor: pointer;
                    transition: transform 0.4s var(--spring), background 0.3s ease, color 0.25s ease, box-shadow 0.35s var(--ease-out);
                    user-select: none;
                    -webkit-tap-highlight-color: transparent;
                    touch-action: manipulation;
                    box-shadow: none;
                }
                .sentiment-row label .seg-icon {
                    width: 1.125rem;
                    height: 1.125rem;
                    display: block;
                    transition: transform 0.45s var(--spring);
                }
                .sentiment-row label .seg-text {
                    position: absolute;
                    width: 1px;
                    height: 1px;
                    padding: 0;
                    margin: -1px;
                    overflow: hidden;
                    clip: rect(0, 0, 0, 0);
                    white-space: nowrap;
                    border: 0;
                }
                .sentiment-row label:active { transform: scale(0.9); }
                .sentiment-row input:focus-visible + label {
                    outline: 2px solid var(--accent);
                    outline-offset: 2px;
                }
                .sentiment-row input[value="Positive"]:checked + label {
                    background: linear-gradient(180deg, rgba(52, 199, 89, 0.32) 0%, rgba(52, 199, 89, 0.16) 100%);
                    color: var(--positive);
                    box-shadow: 0 1px 4px var(--positive-glow), inset 0 1px 0 rgba(255, 255, 255, 0.35);
                    transform: scale(1.06);
                }
                .sentiment-row input[value="Positive"]:checked + label .seg-icon {
                    transform: scale(1.15) translateY(-1px);
                }
                .sentiment-row input[value="Neutral"]:checked + label {
                    background: linear-gradient(180deg, rgba(255, 159, 10, 0.32) 0%, rgba(255, 159, 10, 0.16) 100%);
                    color: var(--neutral);
                    box-shadow: 0 1px 4px var(--neutral-glow), inset 0 1px 0 rgba(255, 255, 255, 0.35);
                    transform: scale(1.06);
                }
                .sentiment-row input[value="Neutral"]:checked + label .seg-icon {
                    transform: scale(1.12);
                }
                .sentiment-row input[value="Negative"]:checked + label {
                    background: linear-gradient(180deg, rgba(255, 59, 48, 0.32) 0%, rgba(255, 59, 48, 0.16) 100%);
                    color: var(--negative);
                    box-shadow: 0 1px 4px var(--negative-glow), inset 0 1px 0 rgba(255, 255, 255, 0.3);
                    transform: scale(1.06);
                }
                .sentiment-row input[value="Negative"]:checked + label .seg-icon {
                    transform: scale(1.15) translateY(1px);
                }

                /* ── Textarea ── */
                .form-field { margin: 0; }
                .form-field label {
                    display: block;
                    font-size: 0.9375rem;
                    font-weight: 600;
                    margin-bottom: 0.625rem;
                    letter-spacing: -0.02em;
                }
                .form-field textarea {
                    width: 100%;
                    min-height: 7rem;
                    padding: 0.875rem 1rem;
                    border: 1.5px solid var(--border-strong);
                    border-radius: var(--radius-md);
                    background: var(--bg-elevated);
                    color: var(--text-primary);
                    font-size: 1rem;
                    font-family: inherit;
                    line-height: 1.45;
                    letter-spacing: -0.01em;
                    resize: vertical;
                    transition: border-color 0.2s ease, box-shadow 0.25s ease;
                    -webkit-appearance: none;
                    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.04);
                }
                .form-field textarea::placeholder { color: var(--text-tertiary); }
                .form-field textarea:focus {
                    outline: none;
                    border-color: var(--accent);
                    box-shadow: 0 0 0 4px var(--accent-glow);
                }
                .form-hint {
                    margin: 0.5rem 0 0;
                    font-size: 0.8125rem;
                    color: var(--text-tertiary);
                    line-height: 1.4;
                }

                /* ── Frosted sticky submit bar ── */
                .submit-bar {
                    position: fixed;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    z-index: 300;
                    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
                    background: var(--bg-glass-strong);
                    backdrop-filter: saturate(180%) blur(24px);
                    -webkit-backdrop-filter: saturate(180%) blur(24px);
                    border-top: 0.5px solid var(--border);
                    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.06);
                }
                .submit-bar-inner { max-width: 28rem; margin: 0 auto; }
                input.btn-submit {
                    width: 100%;
                    border: none;
                    background: linear-gradient(180deg, var(--accent-light) 0%, var(--accent) 100%);
                    color: #fff;
                    border-radius: 999px;
                    padding: 0.9375rem 1.5rem;
                    font-size: 1.0625rem;
                    font-weight: 600;
                    font-family: inherit;
                    letter-spacing: -0.02em;
                    cursor: pointer;
                    min-height: 3.25rem;
                    transition: transform 0.3s var(--spring), box-shadow 0.3s ease, opacity 0.2s ease;
                    touch-action: manipulation;
                    -webkit-tap-highlight-color: transparent;
                    box-shadow: 0 4px 20px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,0.2);
                }
                input.btn-submit:hover {
                    box-shadow: 0 6px 28px var(--accent-glow), inset 0 1px 0 rgba(255,255,255,0.25);
                }
                input.btn-submit:active {
                    transform: scale(0.97);
                    opacity: 0.92;
                }
                input.btn-submit:focus-visible {
                    outline: 2px solid var(--accent-light);
                    outline-offset: 3px;
                }

                /* ── Alerts and empty states ── */
                .alert-error {
                    color: var(--negative);
                    background: var(--negative-bg);
                    border: 1px solid rgba(255, 59, 48, 0.25);
                    border-radius: var(--radius-md);
                    padding: 1rem 1.125rem;
                    font-size: 0.9375rem;
                    line-height: 1.45;
                    margin-bottom: 1rem;
                }
                .empty-state {
                    text-align: center;
                    padding: 2.5rem 1.5rem;
                    animation: fade-up 0.6s var(--ease-out) both;
                }
                .empty-state-icon {
                    width: 4rem;
                    height: 4rem;
                    margin: 0 auto 1.25rem;
                    border-radius: 50%;
                    background: var(--negative-bg);
                    color: var(--negative);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.75rem;
                }
                .empty-state h2 {
                    margin: 0 0 0.5rem;
                    font-size: 1.25rem;
                    font-weight: 700;
                    letter-spacing: -0.03em;
                }
                .empty-state p {
                    margin: 0;
                    color: var(--text-secondary);
                    font-size: 0.9375rem;
                    line-height: 1.5;
                }

                /* ── Success celebration ── */
                .success-panel {
                    text-align: center;
                    padding: 2.5rem 1.5rem 2rem;
                    background: var(--bg-card);
                    border: 0.5px solid var(--border);
                    border-radius: var(--radius-xl);
                    box-shadow: var(--shadow-lg);
                    backdrop-filter: blur(20px);
                    -webkit-backdrop-filter: blur(20px);
                    animation: fade-up 0.7s var(--ease-out) both;
                }
                .success-ring {
                    position: relative;
                    width: 5rem;
                    height: 5rem;
                    margin: 0 auto 1.5rem;
                }
                .success-ring::before {
                    content: "";
                    position: absolute;
                    inset: -8px;
                    border-radius: 50%;
                    background: conic-gradient(from 0deg, var(--positive), var(--accent), var(--positive));
                    opacity: 0.3;
                    animation: spin-glow 3s linear infinite;
                }
                @keyframes spin-glow {
                    to { transform: rotate(360deg); }
                }
                .success-icon {
                    position: relative;
                    width: 5rem;
                    height: 5rem;
                    border-radius: 50%;
                    background: linear-gradient(145deg, #3ddc84 0%, var(--positive) 100%);
                    color: #fff;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 2rem;
                    font-weight: 700;
                    box-shadow: 0 8px 28px var(--positive-glow);
                    animation: success-pop 0.6s var(--spring) both;
                }
                @keyframes success-pop {
                    0% { transform: scale(0.3); opacity: 0; }
                    60% { transform: scale(1.08); }
                    100% { transform: scale(1); opacity: 1; }
                }
                .success-confetti {
                    position: absolute;
                    inset: 0;
                    pointer-events: none;
                    overflow: visible;
                }
                .success-confetti span {
                    position: absolute;
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    animation: confetti-fall 1.2s var(--ease-out) both;
                }
                .success-confetti span:nth-child(1) { left: 10%; background: var(--accent); animation-delay: 0.1s; }
                .success-confetti span:nth-child(2) { left: 30%; background: var(--positive); animation-delay: 0.2s; }
                .success-confetti span:nth-child(3) { left: 50%; background: #ff9500; animation-delay: 0.15s; }
                .success-confetti span:nth-child(4) { left: 70%; background: #af52de; animation-delay: 0.25s; }
                .success-confetti span:nth-child(5) { left: 90%; background: var(--positive); animation-delay: 0.05s; }
                @keyframes confetti-fall {
                    0% { transform: translateY(0) scale(0); opacity: 1; }
                    100% { transform: translateY(-3rem) scale(1); opacity: 0; }
                }
                .success-panel h2 {
                    margin: 0 0 0.5rem;
                    font-size: 1.5rem;
                    font-weight: 700;
                    letter-spacing: -0.03em;
                    background: linear-gradient(135deg, var(--positive) 0%, var(--accent) 100%);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                }
                .success-panel p {
                    margin: 0;
                    color: var(--text-secondary);
                    font-size: 1rem;
                    line-height: 1.5;
                }
                .success-product-img {
                    max-width: 9rem;
                    max-height: 7rem;
                    object-fit: contain;
                    margin: 0 auto 1.25rem;
                    display: block;
                    filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.12));
                    animation: fade-up 0.8s var(--ease-out) 0.2s both;
                }

                /* ── Tablet+ ── */
                @media (min-width: 48rem) {
                    .app-shell { padding-top: 1.5rem; }
                    .product-hero-media { min-height: 13rem; }
                    .product-hero-media img { max-height: 12rem; }
                }

                @media (prefers-reduced-motion: reduce) {
                    *, *::before, *::after {
                        animation-duration: 0.01ms !important;
                        transition-duration: 0.01ms !important;
                    }
                }
            </style>
        </head>
        <body>
            <header class="app-header" role="banner">
                <div class="app-header-inner">
                    <img class="brand-logo" src="{!URLFOR($Resource.chemipharm_logo)}" alt="Chemipharm" />
                    <div class="app-header-text">
                        <div class="eyebrow">Chemipharm</div>
                        <h1>Doctor Feedback</h1>
                    </div>
                </div>
            </header>

            <main class="app-shell">
                <apex:outputPanel rendered="{!invalidRequest}">
                    <div class="glass-card empty-state">
                        <div class="empty-state-icon" aria-hidden="true">!</div>
                        <h2>Link unavailable</h2>
                        <p class="alert-error" role="alert" style="margin-top:1rem;text-align:left;">This survey link is not valid or the visit is no longer available. Please contact your medical representative for a new link.</p>
                    </div>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!AND(NOT(invalidRequest), submitted)}">
                    <div class="success-panel" role="status">
                        <div class="success-ring">
                            <div class="success-confetti" aria-hidden="true">
                                <span></span><span></span><span></span><span></span><span></span>
                            </div>
                            <div class="success-icon" aria-hidden="true">&#10003;</div>
                        </div>
                        <apex:outputPanel rendered="{!hasProductImage}">
                            <img class="success-product-img" src="{!productImageUrl}" alt="{!displayProductName}" />
                        </apex:outputPanel>
                        <h2>Thank you, Doctor!</h2>
                        <p>Your feedback about <strong>{!displayProductName}</strong> has been submitted successfully.</p>
                    </div>
                </apex:outputPanel>

                <apex:outputPanel rendered="{!AND(NOT(invalidRequest), NOT(submitted))}">
                    <article class="product-hero">
                        <div class="product-hero-media">
                            <apex:outputPanel rendered="{!hasProductImage}">
                                <div class="product-hero-img-wrap">
                                    <img src="{!productImageUrl}" alt="{!displayProductName}" loading="eager" />
                                    <div class="product-hero-reflection" aria-hidden="true"></div>
                                </div>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!NOT(hasProductImage)}">
                                <div class="product-hero-avatar" aria-hidden="true">{!productInitials}</div>
                            </apex:outputPanel>
                        </div>
                        <div class="product-hero-body">
                            <h2>{!displayProductName}</h2>
                            <p class="subtitle">Share your clinical feedback to help us improve patient care and field engagement.</p>
                            <div class="meta-row">
                                <apex:outputPanel rendered="{!NOT(ISBLANK(productTherapyArea))}">
                                    <span class="pill-badge pill-badge_accent">{!productTherapyArea}</span>
                                </apex:outputPanel>
                                <apex:outputPanel rendered="{!hasVisitContext}">
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(accountName))}">
                                        <span class="pill-badge pill-badge_neutral">Dr. {!accountName}</span>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(visitDateLabel))}">
                                        <span class="pill-badge pill-badge_neutral">{!visitDateLabel}</span>
                                    </apex:outputPanel>
                                    <apex:outputPanel rendered="{!NOT(ISBLANK(repName))}">
                                        <span class="pill-badge pill-badge_neutral">Rep: {!repName}</span>
                                    </apex:outputPanel>
                                </apex:outputPanel>
                            </div>
                        </div>
                    </article>

                    <apex:form id="surveyForm">
                        <apex:pageMessages />
                        <apex:outputPanel rendered="{!NOT(ISBLANK(errorMessage))}">
                            <p class="alert-error" role="alert">{!errorMessage}</p>
                        </apex:outputPanel>

                        <article class="glass-card">
                            <header class="glass-card__header">
                                <h3 class="glass-card__title">Product Topics</h3>
                                <p class="glass-card__subtitle">Rate each area based on your clinical experience</p>
                            </header>
                            <div class="rating-topic">
                                <span class="rating-label" id="lbl-efficacy">Efficacy</span>
                                <div class="sentiment-segment">
                                    <div class="sentiment-row" role="radiogroup" aria-labelledby="lbl-efficacy">
                                        <apex:selectRadio value="{!efficacySentiment}" layout="lineDirection">
                                            <apex:selectOptions value="{!sentimentOptions}" />
                                        </apex:selectRadio>
                                    </div>
                                </div>
                            </div>
                            <div class="rating-topic">
                                <span class="rating-label" id="lbl-indication">Indication</span>
                                <div class="sentiment-segment">
                                    <div class="sentiment-row" role="radiogroup" aria-labelledby="lbl-indication">
                                        <apex:selectRadio value="{!indicationSentiment}" layout="lineDirection">
                                            <apex:selectOptions value="{!sentimentOptions}" />
                                        </apex:selectRadio>
                                    </div>
                                </div>
                            </div>
                            <div class="rating-topic">
                                <span class="rating-label" id="lbl-safety">Safety</span>
                                <div class="sentiment-segment">
                                    <div class="sentiment-row" role="radiogroup" aria-labelledby="lbl-safety">
                                        <apex:selectRadio value="{!safetySentiment}" layout="lineDirection">
                                            <apex:selectOptions value="{!sentimentOptions}" />
                                        </apex:selectRadio>
                                    </div>
                                </div>
                            </div>
                            <div class="rating-topic">
                                <span class="rating-label" id="lbl-side-effects">Side Effects</span>
                                <div class="sentiment-segment">
                                    <div class="sentiment-row" role="radiogroup" aria-labelledby="lbl-side-effects">
                                        <apex:selectRadio value="{!sideEffectsSentiment}" layout="lineDirection">
                                            <apex:selectOptions value="{!sentimentOptions}" />
                                        </apex:selectRadio>
                                    </div>
                                </div>
                            </div>
                            <div class="rating-topic">
                                <span class="rating-label" id="lbl-usage">Usage</span>
                                <div class="sentiment-segment">
                                    <div class="sentiment-row" role="radiogroup" aria-labelledby="lbl-usage">
                                        <apex:selectRadio value="{!usageSentiment}" layout="lineDirection">
                                            <apex:selectOptions value="{!sentimentOptions}" />
                                        </apex:selectRadio>
                                    </div>
                                </div>
                            </div>
                        </article>

                        <article class="glass-card">
                            <header class="glass-card__header">
                                <h3 class="glass-card__title">Visit &amp; Rep Feedback</h3>
                                <p class="glass-card__subtitle">Optional comments about your visit</p>
                            </header>
                            <div class="form-field">
                                <label for="visitFeedback">Overall comments about your visit and representative</label>
                                <apex:inputTextarea id="visitFeedback" value="{!visitFeedback}" rows="4" />
                                <p class="form-hint">Share thoughts on the discussion, materials, or follow-up needs.</p>
                            </div>
                        </article>

                        <div class="submit-bar">
                            <div class="submit-bar-inner">
                                <apex:commandButton value="Submit Feedback" action="{!submitFeedback}" styleClass="btn-submit" rerender="surveyForm" />
                            </div>
                        </div>
                    </apex:form>
                </apex:outputPanel>
            </main>

            <script>
                (function () {
                    var icons = {
                        Positive: '<svg class="seg-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M7 10v9a1 1 0 0 0 1 1h1.5a1 1 0 0 0 1-1v-5.2M7 10l3.2-4.8a1.2 1.2 0 0 1 2.2.6V10M7 10H4.2a.8.8 0 0 0-.77 1.02l1.4 4.9a.8.8 0 0 0 .77.58H11" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>',
                        Neutral: '<svg class="seg-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M6 12h12" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"/></svg>',
                        Negative: '<svg class="seg-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M17 14V5a1 1 0 0 0-1-1h-1.5a1 1 0 0 0-1 1v5.2M17 14l-3.2 4.8a1.2 1.2 0 0 1-2.2-.6V14M17 14h2.8a.8.8 0 0 0 .77-1.02l-1.4-4.9a.8.8 0 0 0-.77-.58H13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>'
                    };
                    document.querySelectorAll('.sentiment-row label').forEach(function (label) {
                        var text = label.textContent.trim();
                        if (icons[text]) {
                            label.innerHTML = icons[text] + '<span class="seg-text">' + text + '</span>';
                        }
                    });
                })();
            </script>
        </body>
    </html>
</apex:page>
