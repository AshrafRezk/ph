<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false" docType="html-5.0">
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Zeta Pharma</title>
    <style>
        *, *:before, *:after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg-deep: #050A12;
            --bg-mid: #0B1C33;
            --cyan: #00AEEF;
            --royal: #0054A6;
            --text: #E8F1FA;
            --text-muted: rgba(232, 241, 250, 0.62);
            --text-faint: rgba(232, 241, 250, 0.38);
            --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
            --sans: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        }

        html, body {
            height: 100%;
            width: 100%;
            overflow: hidden;
            background: var(--bg-deep);
            color: var(--text);
            font-family: var(--sans);
            -webkit-font-smoothing: antialiased;
        }

        .stage {
            position: relative;
            height: 100%;
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: clamp(1.75rem, 5vw, 3.5rem);
            overflow: hidden;
            background:
                radial-gradient(ellipse 80% 60% at 70% 20%, rgba(0, 174, 239, 0.18) 0%, transparent 55%),
                radial-gradient(ellipse 70% 50% at 15% 85%, rgba(0, 84, 166, 0.32) 0%, transparent 50%),
                linear-gradient(165deg, var(--bg-deep) 0%, var(--bg-mid) 48%, #071525 100%);
        }

        #scene {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .cursor-glow {
            position: absolute;
            width: 220px;
            height: 220px;
            margin: -110px 0 0 -110px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(0,174,239,0.22) 0%, rgba(0,84,166,0.08) 42%, transparent 70%);
            pointer-events: none;
            z-index: 1;
            mix-blend-mode: screen;
            will-change: transform;
        }

        .logo-hover {
            position: absolute;
            top: 18%;
            left: 50%;
            z-index: 3;
            transform: translate3d(-50%, 0, 0);
            transform-style: preserve-3d;
            perspective: 900px;
            will-change: transform;
            filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.45)) drop-shadow(0 0 18px rgba(255,255,255,0.12));
        }

        .logo-hover img {
            display: block;
            width: min(68vw, 320px);
            height: auto;
        }

        .mini-z {
            position: absolute;
            width: 52px;
            height: 52px;
            margin: -26px 0 0 -26px;
            object-fit: contain;
            pointer-events: none;
            z-index: 5;
            filter: drop-shadow(0 0 10px rgba(255,255,255,0.35));
            will-change: transform;
        }

        .copy {
            position: relative;
            z-index: 3;
            max-width: 22rem;
            will-change: transform;
        }

        .headline {
            font-family: var(--serif);
            font-weight: 500;
            font-size: clamp(1.55rem, 4vw, 2.35rem);
            line-height: 1.18;
            letter-spacing: -0.02em;
            color: var(--text);
            margin-bottom: 0.75rem;
        }

        .headline span { display: inline-block; will-change: transform; }

        .support {
            font-size: clamp(0.9rem, 1.8vw, 1.05rem);
            line-height: 1.5;
            color: var(--text-muted);
            font-weight: 400;
            max-width: 18rem;
        }

        .accent-line {
            width: 2.5rem;
            height: 2px;
            margin: 0 0 1.35rem;
            border-radius: 1px;
            background: linear-gradient(90deg, var(--cyan), var(--royal));
            transform-origin: left center;
            will-change: transform;
        }

        .footer {
            position: absolute;
            bottom: clamp(1rem, 3vw, 1.5rem);
            right: clamp(1.75rem, 5vw, 3.5rem);
            font-size: 0.7rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--text-faint);
            z-index: 3;
        }

        @media (max-width: 420px) {
            .logo-hover { top: 10%; }
            .logo-hover img { width: min(82vw, 280px); }
            .mini-z { width: 40px; height: 40px; margin: -20px 0 0 -20px; }
            .copy { max-width: 100%; }
        }
    </style>
</head>
<body>
    <c:PendingPaymentAlert theme="dark" />
    <div class="stage" id="stage">
        <canvas id="scene"></canvas>
        <div class="cursor-glow" id="glow"></div>
        <img class="mini-z" id="miniZ" src="data:image/png;base64," alt="" />
        <div class="logo-hover" id="logo">
            <img src="data:image/png;base64," alt="Zeta Pharma" />
        </div>
        <div class="copy" id="copy">
            <div class="accent-line" id="line" aria-hidden="true"></div>
            <h1 class="headline" id="headline">Science that reaches every patient</h1>
            <p class="support">Sign in to continue your field day with clarity and care.</p>
        </div>
        <p class="footer">Field excellence</p>
    </div>
    <script>
    //<![CDATA[
    (function () {
        var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var stage = document.getElementById("stage");
        var canvas = document.getElementById("scene");
        var logo = document.getElementById("logo");
        var copy = document.getElementById("copy");
        var glow = document.getElementById("glow");
        var miniZ = document.getElementById("miniZ");
        var line = document.getElementById("line");
        var headline = document.getElementById("headline");
        if (!stage || !canvas || !logo) return;

        var words = (headline.textContent || "").split(" ");
        headline.textContent = "";
        words.forEach(function (word, i) {
            var span = document.createElement("span");
            span.textContent = word;
            headline.appendChild(span);
            if (i < words.length - 1) headline.appendChild(document.createTextNode(" "));
        });
        var letters = headline.querySelectorAll("span");
        if (reduce) return;

        function Spring(value, stiffness, damping) {
            this.value = value;
            this.target = value;
            this.vel = 0;
            this.k = stiffness;
            this.d = damping;
        }
        Spring.prototype.set = function (t) { this.target = t; };
        Spring.prototype.tick = function (dt) {
            this.vel += (-this.k * (this.value - this.target) - this.d * this.vel) * dt;
            this.value += this.vel * dt;
            return this.value;
        };

        var mouse = { x: 0.5, y: 0.42, active: false };
        var mx = new Spring(0.5, 18, 8);
        var my = new Spring(0.42, 18, 8);
        var tiltX = new Spring(0, 28, 10);
        var tiltY = new Spring(0, 28, 10);
        var logoY = new Spring(0, 14, 7);
        var glowX = new Spring(0.5, 16, 9);
        var glowY = new Spring(0.42, 16, 9);
        var lineW = new Spring(0, 20, 9);
        var copyX = new Spring(0, 16, 9);
        var copyY = new Spring(0, 16, 9);
        var zX = new Spring(0.62, 12, 7);
        var zY = new Spring(0.28, 12, 7);
        var zRot = new Spring(0, 10, 8);

        var ctx = canvas.getContext("2d");
        var w = 0, h = 0, dpr = 1;
        var particles = [];
        var ripples = [];
        var t0 = performance.now();

        function resize() {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            w = stage.clientWidth;
            h = stage.clientHeight;
            canvas.width = Math.floor(w * dpr);
            canvas.height = Math.floor(h * dpr);
            canvas.style.width = w + "px";
            canvas.style.height = h + "px";
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function seed() {
            particles = [];
            var count = Math.round(Math.min(140, Math.max(70, (w * h) / 9000)));
            for (var i = 0; i < count; i++) {
                particles.push({
                    x: (Math.random() - 0.5) * 2.2,
                    y: (Math.random() - 0.5) * 2.2,
                    z: Math.random() * 2 - 1,
                    r: 1.1 + Math.random() * 2.4,
                    hue: Math.random() > 0.55 ? "0,174,239" : "61,143,212",
                    spin: (Math.random() - 0.5) * 0.25
                });
            }
        }

        function project(p, rotY, rotX) {
            var cosY = Math.cos(rotY), sinY = Math.sin(rotY);
            var cosX = Math.cos(rotX), sinX = Math.sin(rotX);
            var x1 = p.x * cosY - p.z * sinY;
            var z1 = p.x * sinY + p.z * cosY;
            var y1 = p.y * cosX - z1 * sinX;
            var z2 = p.y * sinX + z1 * cosX;
            var depth = 1.85 / (2.15 + z2);
            return {
                sx: w * 0.5 + x1 * depth * Math.min(w, h) * 0.46,
                sy: h * 0.42 + y1 * depth * Math.min(w, h) * 0.46,
                depth: depth,
                z: z2
            };
        }

        function onMove(e) {
            var rect = stage.getBoundingClientRect();
            mouse.x = (e.clientX - rect.left) / rect.width;
            mouse.y = (e.clientY - rect.top) / rect.height;
            mouse.active = true;
            mx.set(mouse.x);
            my.set(mouse.y);
            glowX.set(mouse.x);
            glowY.set(mouse.y);
            tiltY.set((mouse.x - 0.5) * 16);
            tiltX.set((0.42 - mouse.y) * 12);
            copyX.set((mouse.x - 0.5) * 16);
            copyY.set((mouse.y - 0.5) * 10);
        }

        function onLeave() {
            mouse.active = false;
            mx.set(0.5); my.set(0.42);
            glowX.set(0.5); glowY.set(0.42);
            tiltX.set(0); tiltY.set(0);
            copyX.set(0); copyY.set(0);
        }

        stage.addEventListener("mousemove", onMove);
        stage.addEventListener("mouseleave", onLeave);
        stage.addEventListener("click", function (e) {
            var rect = stage.getBoundingClientRect();
            ripples.push({ x: e.clientX - rect.left, y: e.clientY - rect.top, life: 0 });
        });
        window.addEventListener("resize", function () { resize(); seed(); });

        lineW.set(1);
        resize();
        seed();

        function frame(now) {
            var dt = Math.min(0.032, (now - t0) / 1000);
            t0 = now;
            mx.tick(dt); my.tick(dt);
            tiltX.tick(dt); tiltY.tick(dt);
            glowX.tick(dt); glowY.tick(dt);
            copyX.tick(dt); copyY.tick(dt);
            lineW.tick(dt);
            logoY.set(Math.sin(now / 900) * 10);
            logoY.tick(dt);

            var orbit = now / 650;
            var radius = mouse.active ? 58 : 78;
            var originX = mouse.active ? mouse.x : 0.5;
            var originY = mouse.active ? mouse.y : 0.28;
            zX.set(originX + Math.cos(orbit) * (radius / w));
            zY.set(originY + Math.sin(orbit * 1.15) * (radius / h));
            zRot.set(orbit * 28);
            zX.tick(dt); zY.tick(dt); zRot.tick(dt);

            glow.style.transform = "translate3d(" + (glowX.value * w) + "px," + (glowY.value * h) + "px,0)";
            miniZ.style.transform = "translate3d(" + (zX.value * w) + "px," + (zY.value * h) + "px,0) rotate(" + zRot.value.toFixed(1) + "deg)";
            logo.style.transform = "translate3d(calc(-50% + " + ((mx.value - 0.5) * 22).toFixed(2) + "px)," + logoY.value.toFixed(2) + "px,0) rotateX(" + tiltX.value.toFixed(2) + "deg) rotateY(" + tiltY.value.toFixed(2) + "deg)";
            copy.style.transform = "translate3d(" + copyX.value.toFixed(2) + "px," + copyY.value.toFixed(2) + "px,0)";
            line.style.transform = "scaleX(" + Math.max(0, lineW.value).toFixed(3) + ")";

            var pull = mouse.active ? 1 : 0.35;
            letters.forEach(function (el, i) {
                var ly = (my.value - 0.5) * -8 + Math.sin(now / 700 + i) * 1.4;
                var lx = (mx.value - 0.5) * 10 + (i - letters.length / 2) * 0.8;
                el.style.transform = "translate3d(" + lx.toFixed(1) + "px," + ly.toFixed(1) + "px,0)";
            });

            ctx.clearRect(0, 0, w, h);
            var rotY = now / 9000 + (mx.value - 0.5) * 0.9;
            var rotX = 0.18 + (my.value - 0.5) * 0.55;
            var pts = [];
            for (var i = 0; i < particles.length; i++) {
                var p = particles[i];
                p.z += p.spin * dt;
                if (p.z > 1.2) p.z = -1.2;
                if (p.z < -1.2) p.z = 1.2;
                var pr = project({
                    x: p.x + (mx.value - 0.5) * pull * 0.15,
                    y: p.y + (my.value - 0.5) * pull * 0.12,
                    z: p.z
                }, rotY, rotX);
                pts.push({ p: pr, src: p });
            }

            for (var a = 0; a < pts.length; a++) {
                for (var b = a + 1; b < pts.length; b++) {
                    var pa = pts[a].p, pb = pts[b].p;
                    var dist = Math.hypot(pa.sx - pb.sx, pa.sy - pb.sy);
                    if (dist < 92) {
                        var alpha = (1 - dist / 92) * 0.18 * Math.min(pa.depth, pb.depth);
                        ctx.strokeStyle = "rgba(125,216,247," + alpha.toFixed(3) + ")";
                        ctx.beginPath();
                        ctx.moveTo(pa.sx, pa.sy);
                        ctx.lineTo(pb.sx, pb.sy);
                        ctx.stroke();
                    }
                }
            }

            var cx = mx.value * w, cy = my.value * h;
            for (var j = 0; j < pts.length; j++) {
                var item = pts[j], prj = item.p, src = item.src;
                var md = Math.hypot(prj.sx - cx, prj.sy - cy);
                var boost = mouse.active && md < 140 ? (1 - md / 140) * 2.2 : 0;
                ctx.beginPath();
                ctx.fillStyle = "rgba(" + src.hue + "," + (0.22 + prj.depth * 0.55).toFixed(3) + ")";
                ctx.arc(prj.sx, prj.sy, src.r * prj.depth * 2.1 + boost, 0, Math.PI * 2);
                ctx.fill();
            }

            for (var r = ripples.length - 1; r >= 0; r--) {
                var ripple = ripples[r];
                ripple.life += dt;
                ctx.beginPath();
                ctx.strokeStyle = "rgba(0,174,239," + Math.max(0, 0.35 - ripple.life * 0.45).toFixed(3) + ")";
                ctx.lineWidth = 2;
                ctx.arc(ripple.x, ripple.y, ripple.life * 220, 0, Math.PI * 2);
                ctx.stroke();
                if (ripple.life > 0.9) ripples.splice(r, 1);
            }

            requestAnimationFrame(frame);
        }
        requestAnimationFrame(frame);
    })();
    //]]>
    </script>
</body>
</html>
</apex:page>