                        it.el.addEventListener('pointerup', function () { release(it); });
                    });
                    function onTilt(e) {
                        if (e.beta == null || e.gamma == null) return;
                        var beta = Math.max(-30, Math.min(30, e.beta - 35));
                        var gamma = Math.max(-30, Math.min(30, e.gamma));
                        gx = beta / 30 * -5;
                        gy = gamma / 30 * 6;
                        document.body.style.setProperty('--ax', (gamma * 0.35).toFixed(1) + 'px');
                        document.body.style.setProperty('--ay', (beta * 0.25).toFixed(1) + 'px');
