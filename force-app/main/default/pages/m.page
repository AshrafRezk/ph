                            if (!it.held) { it.tx = gx; it.ty = gy; }
                            it.x += (it.tx - it.x) * 0.16;
                            it.y += (it.ty - it.y) * 0.16;
                            it.gx += (it.tgx - it.gx) * 0.16;
                            it.gy += (it.tgy - it.gy) * 0.16;
                            it.scale += (it.tscale - it.scale) * 0.16;
                            if (Math.abs(it.tx - it.x) > 0.04 || Math.abs(it.ty - it.y) > 0.04 || Math.abs(it.tscale - it.scale) > 0.004) alive = true;
                            it.el.style.transform = 'rotateX(' + it.x.toFixed(2) + 'deg) rotateY(' + it.y.toFixed(2) + 'deg) scale(' + it.scale.toFixed(3) + ')';
                            it.el.style.setProperty('--gx', it.gx.toFixed(1) + '%');
                            it.el.style.setProperty('--gy', it.gy.toFixed(1) + '%');
                        });
                        if (alive) window.requestAnimationFrame(loop);
                        else running = false;
                    }
                    function point(it, e) {
                        var r = it.el.getBoundingClientRect();
                        var px = (e.clientX - r.left) / r.width - 0.5;
                        var py = (e.clientY - r.top) / r.height - 0.5;
                        it.ty = Math.max(-8, Math.min(8, px * 10));
                        it.tx = Math.max(-8, Math.min(8, py * -8));
                        it.tgx = 50 + px * 70;
                        it.tgy = 28 + py * 46;
                        it.held = true;
                        kick();
                    }
                    function release(it) { it.held = false; it.tgx = 42; it.tgy = 16; kick(); }
                    items.forEach(function (it) {
                        it.el.addEventListener('pointermove', function (e) {
                            if (e.pointerType !== 'mouse') return;
                            point(it, e);
                        });
                        it.el.addEventListener('pointerdown', function (e) {
                            if (e.pointerType === 'mouse' || e.target.closest('a, button')) return;
                            point(it, e);
                        });
