                    if (window.DeviceOrientationEvent && typeof DeviceOrientationEvent.requestPermission === 'function') {
                        var tiltRoot = document.getElementById('homeStage') || document;
                        tiltRoot.addEventListener('pointerdown', function once(e) {
                            if (e.target.closest('a, button, input, textarea, select')) return;
                            tiltRoot.removeEventListener('pointerdown', once);
                            DeviceOrientationEvent.requestPermission().then(function (state) {
                                if (state === 'granted') listen();
                            }).catch(function () {});
                        });
                    } else if (window.DeviceOrientationEvent) listen();
                    window.Zeta._tilt = items;
                }

                function bindPresent() {
                    var pass = document.querySelector('#homeStage .pass');
                    if (!pass) return;
                    var timer = 0;
                    var down = false;
                    var sx = 0;
                    var sy = 0;
                    function tilt() {
                        return (window.Zeta._tilt || []).filter(function (it) { return it.el === pass; })[0];
                    }
                    function begin(e) {
                        if (e.target.closest('a, button')) return;
                        down = true;
                        sx = e.clientX;
                        sy = e.clientY;
                        window.clearTimeout(timer);
                        timer = window.setTimeout(function () {
                            if (!down) return;
                            pass.classList.add('is-presenting');
                            haptic('rigid');
                            var item = tilt();
                            if (item) item.tscale = 1.035;
                            if (window.Zeta._kick) window.Zeta._kick();
                        }, 190);
                    }
                    function end() {
                        var was = pass.classList.contains('is-presenting');
                        down = false;
                        window.clearTimeout(timer);
                        pass.classList.remove('is-presenting');
                        var item = tilt();
                        if (item) item.tscale = 1;
                        if (window.Zeta._kick) window.Zeta._kick();
                        if (was) haptic('soft');
                    }
                    pass.addEventListener('pointerdown', begin);
                    pass.addEventListener('pointermove', function (e) {
                        if (!down) return;
                        if (Math.abs(e.clientX - sx) > 12 || Math.abs(e.clientY - sy) > 12) {
                            down = false;
                            window.clearTimeout(timer);
                        }
                    });
                    pass.addEventListener('pointerup', end);
                    pass.addEventListener('pointercancel', end);
                    pass.addEventListener('pointerleave', end);
                }

                function bindAmbient() {
                    var canvas = document.createElement('canvas');
                    canvas.className = 'ambient';
                    canvas.setAttribute('aria-hidden', 'true');
                    document.body.insertBefore(canvas, document.body.firstChild);
                    var ctx = canvas.getContext('2d');
                    if (!ctx) return;
                    var dpr = 1;
                    var dots = [];
                    function resize() {
                        dpr = Math.min(window.devicePixelRatio || 1, 2);
                        canvas.width = Math.floor(window.innerWidth * dpr);
                        canvas.height = Math.floor(window.innerHeight * dpr);
                        canvas.style.width = window.innerWidth + 'px';
                        canvas.style.height = window.innerHeight + 'px';
                    }
                    resize();
                    window.addEventListener('resize', resize);
                    var i;
                    for (i = 0; i < 18; i++) {
                        dots.push({
                            x: Math.random(),
                            y: Math.random(),
                            r: 1.1 + Math.random() * 2.4,
                            v: 0.008 + Math.random() * 0.02,
                            a: 0.12 + Math.random() * 0.28,
                            w: Math.random() * Math.PI * 2
                        });
                    }
                    var raf = 0;
                    function frame(t) {
                        if (!document.body.classList.contains('is-home') || document.hidden) {
                            raf = 0;
                            return;
                        }
                        var w = window.innerWidth;
                        var h = window.innerHeight;
                        var span = h + 40;
                        var ax = parseFloat(document.body.style.getPropertyValue('--ax')) || 0;
                        var ay = parseFloat(document.body.style.getPropertyValue('--ay')) || 0;
                        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
                        ctx.clearRect(0, 0, w, h);
                        dots.forEach(function (d) {
                            var y = (d.y * span - t * d.v) % span;
                            if (y < 0) y += span;
                            var x = d.x * w + Math.sin(t * 0.0003 + d.w) * 14 + ax * 1.4;
                            ctx.beginPath();
                            ctx.fillStyle = 'rgba(11,92,171,' + d.a + ')';
                            ctx.arc(x, y + ay * 0.4, d.r, 0, Math.PI * 2);
                            ctx.fill();
                        });
                        raf = window.requestAnimationFrame(frame);
                    }
                    function wake() {
                        if (!raf && document.body.classList.contains('is-home') && !document.hidden) raf = window.requestAnimationFrame(frame);
                    }
                    document.addEventListener('zeta:tab', wake);
                    document.addEventListener('visibilitychange', wake);
                    wake();
                }

                function start() {
                    bindFeel();
                    Object.keys(tabs).forEach(function (name) { if (tabs[name].render) tabs[name].render(); });
                    document.querySelectorAll('[data-go]').forEach(function (el) {
                        el.addEventListener('click', function () { go(el.getAttribute('data-go')); });
                    });
                    document.getElementById('sheet').addEventListener('click', function (e) {
                        if (e.target.id === 'sheet' || e.target.closest('.sheet__close')) closeSheet();
                    });
                    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeSheet(); });
                    window.addEventListener('popstate', function (e) {
                        closeSheet();
                        go((e.state && e.state.tab) || new URLSearchParams(window.location.search).get('t') || 'home', null, 'pop');
                    });
                    go(params.get('t') || 'home', null, 'replace');
                    fitStage();
                    window.requestAnimationFrame(function () { fitStage(); positionPill(); });
                }
                return { data: data, tabs: tabs, esc: esc, paragraphs: paragraphs, go: go, sheet: sheet, closeSheet: closeSheet, toast: toast, product: product, request: request, start: start, haptic: haptic };
            })();
            </script>
        </head>
        <body class="is-home{!IF(showEvents, '', ' is-public')}">
            <div class="wrap">
                <header class="top">
                    <img src="{!logoDataUri}" alt="Zeta" />
                    <b>Zeta Pharma</b>
                    <span class="net" id="net" hidden="hidden">Offline</span>
                </header>

                <section class="tab" id="tab-home" data-tab="home">
                    <div class="stage" id="homeStage">
                    <div class="scene scene--invite" data-scene="Invitation">
                    <div class="scene__in">
                    <div class="tab__head">
                        <h1 class="title" id="homeHello">Welcome to Zeta</h1>
                        <p class="sub">{!IF(showEvents, 'Your events, our products and your Zeta team in one place.', 'Our products and the latest from Zeta.')}</p>
                    </div>

                    <apex:outputPanel rendered="{!AND(hasCode, invalid)}" layout="block" styleClass="card">
                        <div class="eyebrow">Invitation</div>
                        <h1>This link is not valid</h1>
                        <p class="hello">Ask the person who invited you to send the invitation again.</p>
                        <p class="ar">هذا الرابط غير صالح. برجاء طلب دعوة جديدة.</p>
                    </apex:outputPanel>

                    <apex:outputPanel rendered="{!AND(NOT(invalid), cancelled)}" layout="block" styleClass="card">
                        <div class="eyebrow">Invitation</div>
                        <h1>{!meetingTitle}</h1>
                        <p class="hello">This meeting has been cancelled. Thank you for your interest.</p>
                        <p class="ar">تم إلغاء هذا الاجتماع.</p>
                    </apex:outputPanel>

                    <apex:outputPanel rendered="{!AND(NOT(invalid), NOT(cancelled))}" layout="block" styleClass="card">
                        <apex:outputPanel rendered="{!NOT(ISBLANK(message))}" layout="block" styleClass="flash">{!message}</apex:outputPanel>
                        <div class="eyebrow">You are invited</div>
                        <h1>{!meetingTitle}</h1>
                        <p class="hello">Hello {!guestName}</p>
                        <ul class="facts">
                            <apex:outputPanel rendered="{!NOT(ISBLANK(whenText))}" layout="none">
                                <li><b>When</b>{!whenText}</li>
                            </apex:outputPanel>
                            <apex:outputPanel rendered="{!NOT(ISBLANK(venue))}" layout="none">
                                <li><b>Where</b>{!venue}</li>
                            </apex:outputPanel>
                            <li><b>Your status</b><span class="pill {!IF(OR(checkedIn, status == 'Confirmed'), 'ok', '')}">{!statusLabel}</span></li>
                        </ul>

                        <apex:outputPanel rendered="{!checkedIn}" layout="block" styleClass="done">
                            <div class="tick">&#10003;</div>
                            <strong>Checked in at {!checkedInText}</strong>
                            <p class="note">Welcome. Enjoy the meeting.</p>
                            <p class="ar">تم تسجيل حضورك. أهلاً بك.</p>
