            <apex:outputPanel rendered="{!AND(NOT(invalid), showQr)}" layout="none">
                <script><apex:outputText value="{!qrLibScript}" escape="false" /></script>
                <script>
                (function () {
                    var secret = '{!JSENCODE(qrSecret)}';
                    var code = '{!JSENCODE(code)}';
                    var prefix = '{!JSENCODE(tokenPrefix)}';
                    var skew = {!serverMillis} - Date.now();
                    var offset = Math.abs(skew) < 600000 ? skew : 0;
                    var canvas = document.getElementById('qr');
                    var box = document.getElementById('qrBox');
                    var cover = document.getElementById('qrCover');
                    var bar = document.getElementById('bar');
                    var clock = document.getElementById('clock');
                    var ctx = canvas.getContext('2d');
                    var enc = new TextEncoder();
                    var logo = new Image();
                    var logoReady = false;
                    var shown = -1;
                    logo.onload = function () { logoReady = true; shown = -1; };
                    logo.src = '{!JSENCODE(logoDataUri)}';

                    if (!window.crypto || !window.crypto.subtle || !secret) {
                        box.classList.add('is-error');
                        cover.textContent = 'Open this link in Chrome or Safari to show your code.';
                        return;
                    }
                    var keyPromise = crypto.subtle.importKey('raw', enc.encode(secret), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);

                    function hex(buffer) {
                        var bytes = new Uint8Array(buffer), out = '';
                        for (var i = 0; i < 8; i++) { out += ('0' + bytes[i].toString(16)).slice(-2); }
                        return out;
                    }

                    function roundRect(x, y, w, h, r) {
                        ctx.moveTo(x + r, y);
                        ctx.arcTo(x + w, y, x + w, y + h, r);
                        ctx.arcTo(x + w, y + h, x, y + h, r);
                        ctx.arcTo(x, y + h, x, y, r);
                        ctx.arcTo(x, y, x + w, y, r);
                        ctx.closePath();
                    }

                    function draw(text) {
                        var qr = qrcode(0, 'H');
                        qr.addData(text);
                        qr.make();
                        var n = qr.getModuleCount();
                        var size = canvas.width;
                        var quiet = 2;
                        var cell = size / (n + quiet * 2);
                        var logoCells = Math.ceil((n * 0.2) / 2) * 2 + 1;
                        var lo = Math.floor((n - logoCells) / 2);
                        ctx.fillStyle = '#ffffff';
                        ctx.fillRect(0, 0, size, size);
                        ctx.fillStyle = '#032d60';
                        ctx.beginPath();
                        for (var r = 0; r < n; r++) {
                            for (var c = 0; c < n; c++) {
                                if (!qr.isDark(r, c)) continue;
                                if ((r < 7 && c < 7) || (r < 7 && c >= n - 7) || (r >= n - 7 && c < 7)) continue;
                                if (r >= lo && r < lo + logoCells && c >= lo && c < lo + logoCells) continue;
                                roundRect((c + quiet) * cell + 0.5, (r + quiet) * cell + 0.5, cell - 1, cell - 1, cell * 0.3);
                            }
                        }
                        ctx.fill();
                        [[0, 0], [0, n - 7], [n - 7, 0]].forEach(function (p) {
                            var x = (p[1] + quiet) * cell, y = (p[0] + quiet) * cell;
                            ctx.beginPath();
                            roundRect(x, y, cell * 7, cell * 7, cell * 2);
                            roundRect(x + cell, y + cell, cell * 5, cell * 5, cell);
                            ctx.fill('evenodd');
                            ctx.beginPath();
                            roundRect(x + cell * 2, y + cell * 2, cell * 3, cell * 3, cell * 1.1);
                            ctx.fill();
                        });
                        var bx = (lo + quiet) * cell, bw = logoCells * cell, pad = cell * 0.6;
                        ctx.fillStyle = '#ffffff';
                        ctx.beginPath();
                        roundRect(bx, bx, bw, bw, cell * 1.4);
                        ctx.fill();
                        if (logoReady) {
                            var inner = bw - pad * 2;
                            var scale = Math.min(inner / logo.width, inner / logo.height);
                            var w = logo.width * scale, h = logo.height * scale;
                            ctx.drawImage(logo, bx + (bw - w) / 2, bx + (bw - h) / 2, w, h);
                        }
                    }

                    function two(v) { return (v < 10 ? '0' : '') + v; }

                    var alreadyIn = {!IF(checkedIn, 'true', 'false')};
                    var stepMs = {!tokenStepSeconds} * 1000;
                    var ticked = -1;
                    function frame() {
                        var now = Date.now() + offset;
                        var step = Math.floor(now / stepMs);
                        var second = Math.floor(now / 1000);
                        bar.style.width = ((now % stepMs) / stepMs * 100).toFixed(2) + '%';
                        if (second !== ticked) {
                            ticked = second;
                            var d = new Date(now);
                            clock.textContent = two(d.getHours()) + ':' + two(d.getMinutes()) + ':' + two(d.getSeconds());
                        }
                        if (step !== shown) {
                            var firstCode = shown < 0;
                            shown = step;
                            keyPromise
                                .then(function (key) { return crypto.subtle.sign('HMAC', key, enc.encode(code + ':' + step)); })
                                .then(function (sig) { if (step === shown) draw(prefix + ':' + code + ':' + step + ':' + hex(sig)); });
                            if (!firstCode) {
                                var passEl = document.querySelector('#homeStage .pass');
                                if (passEl) {
                                    passEl.classList.add('is-tick');
                                    window.setTimeout(function () { passEl.classList.remove('is-tick'); }, 600);
                                }
                                if (window.Zeta && window.Zeta.haptic) window.Zeta.haptic('tick');
                            }
                        }
                        window.requestAnimationFrame(frame);
                    }
                    window.requestAnimationFrame(frame);

                    document.addEventListener('visibilitychange', function () {
                        box.classList.toggle('is-hidden', document.hidden);
                    });
                    box.addEventListener('click', function () { box.classList.remove('is-hidden'); });

                    var self = window.location.pathname + '?c=' + encodeURIComponent(code);
                    function poll() {
                        if (document.hidden || !window.fetch || !navigator.onLine) return;
                        fetch(self + '&s=1', { cache: 'no-store', credentials: 'same-origin' })
                            .then(function (res) { return res.ok ? res.text() : ''; })
                            .then(function (text) { if (!alreadyIn && text.indexOf('Checked In') !== -1) window.location.replace(self); })
                            .catch(function () {});
                    }
                    window.setInterval(poll, 4000);
                })();
                </script>
            </apex:outputPanel>

            <script>
            (function () {
                var LAST = 'zetaPass.last';
                var DISMISSED = 'zetaPass.installDismissed';
                var code = '{!IF(invalid, '', JSENCODE(code))}';
                var store = window.localStorage;
                var params = new URLSearchParams(window.location.search);

                if (code) {
                    try { store.setItem(LAST, code); } catch (e) {}
                } else if (!params.get('c')) {
                    var last = null;
                    try { last = store.getItem(LAST); } catch (e) {}
                    if (last) {
                        window.location.replace(window.location.pathname + '?c=' + encodeURIComponent(last) + (params.get('t') ? '&t=' + encodeURIComponent(params.get('t')) : ''));
                        return;
                    }
                }

                window.Zeta.start();
                bindPin();

                if ('serviceWorker' in navigator && window.location.pathname.indexOf('/apex/') !== 0) {
                    navigator.serviceWorker.register(window.location.pathname + '?f=sw', { scope: window.location.pathname }).catch(function () {});
                }

                var netBadge = document.getElementById('net');
                function showNet() { netBadge.hidden = navigator.onLine; }
                window.addEventListener('online', showNet);
                window.addEventListener('offline', showNet);
                showNet();

                var bar = document.getElementById('install');
                var btn = document.getElementById('installBtn');
                var hint = document.getElementById('installHint');
                var qrBox = document.getElementById('qrBox');
                var deferred = null;
                var wanted = false;
                var qrInView = false;
                var standalone = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
                var ios = /iphone|ipad|ipod/i.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
                function dismissed() { try { return !!store.getItem(DISMISSED); } catch (e) { return false; } }
                function sync() { bar.hidden = !wanted || qrInView || document.body.classList.contains('sheet-open'); }
                function offer() {
                    if (standalone || dismissed()) return;
                    if (deferred) {
                        btn.hidden = false;
                        wanted = true;
                    } else if (ios) {
                        hint.textContent = 'Tap Share, then "Add to Home Screen".';
                        btn.hidden = true;
                        wanted = true;
                    }
                    sync();
                }
                if (qrBox && 'IntersectionObserver' in window) {
                    new IntersectionObserver(function (entries) {
                        qrInView = entries[0].isIntersecting && !document.getElementById('tab-home').hidden;
                        sync();
                    }).observe(qrBox);
                    document.addEventListener('zeta:tab', function (e) {
                        if (e.detail !== 'home') { qrInView = false; sync(); }
                    });
                }
                window.addEventListener('beforeinstallprompt', function (e) {
                    e.preventDefault();
                    deferred = e;
                    offer();
                });
                btn.addEventListener('click', function () {
                    if (!deferred) return;
                    deferred.prompt();
                    deferred.userChoice.then(function () { deferred = null; wanted = false; sync(); });
                });
                document.getElementById('installClose').addEventListener('click', function () {
                    wanted = false;
                    sync();
                    try { store.setItem(DISMISSED, '1'); } catch (e) {}
                });
                window.addEventListener('appinstalled', function () { wanted = false; sync(); });
                setTimeout(offer, 3000);

                function bindPin() {
                    var form = document.getElementById('pinForm');
                    var check = document.getElementById('pinCheck');
                    var msg = document.getElementById('pinMsg');
                    if (!form || !check || !msg) return;
                    var ident = '';
                    function say(text) {
                        msg.hidden = !text;
                        msg.textContent = text || '';
                    }
                    function post(data) {
                        return fetch(window.location.pathname + '?a=pin', {
                            method: 'POST',
                            body: new URLSearchParams(data),
                            credentials: 'same-origin',
                            cache: 'no-store'
                        }).then(function (res) { return res.json(); });
                    }
                    form.addEventListener('submit', function (e) {
                        e.preventDefault();
                        ident = form.querySelector('input').value.trim();
                        if (!ident) { say('Enter your HCP code or mobile number.'); return; }
                        var btn = form.querySelector('button');
                        btn.disabled = true;
                        post({ step: 'send', who: ident }).then(function (res) {
                            btn.disabled = false;
                            if (!res || !res.ok) { say((res && res.message) || 'Please try again.'); return; }
                            form.hidden = true;
                            check.hidden = false;
                            say(res.message);
                            check.querySelector('input').focus();
                        }).catch(function () {
                            btn.disabled = false;
                            say('Please try again.');
                        });
                    });
                    check.addEventListener('submit', function (e) {
                        e.preventDefault();
                        var pin = check.querySelector('input').value.trim();
                        if (!/^\d{6}$/.test(pin)) { say('Enter the 6-digit PIN.'); return; }
                        var btn = check.querySelector('button[type="submit"]');
                        btn.disabled = true;
                        post({ step: 'check', who: ident, pin: pin }).then(function (res) {
                            if (res && res.ok) { window.location.replace(window.location.pathname); return; }
                            btn.disabled = false;
                            say((res && res.message) || 'That PIN is not right, or it has expired.');
                        }).catch(function () {
                            btn.disabled = false;
                            say('Please try again.');
                        });
                    });
                    document.getElementById('pinBack').addEventListener('click', function () {
                        check.hidden = true;
                        check.querySelector('input').value = '';
                        form.hidden = false;
                        say('');
                        form.querySelector('input').focus();
                    });
                }
            })();
            </script>
        </body>
    </html>
    </apex:outputPanel>
</apex:page>
