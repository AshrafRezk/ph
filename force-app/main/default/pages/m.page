                        if ('IntersectionObserver' in window) {
                            var io = new IntersectionObserver(function (entries) {
                                if (Date.now() < skipUntil) return;
                                var best = null;
                                entries.forEach(function (entry) {
                                    if (!best || entry.intersectionRatio > best.intersectionRatio) best = entry;
                                });
                                if (!best || best.intersectionRatio < 0.55) return;
                                var i = scenes.indexOf(best.target);
                                if (i < 0 || i === active) return;
                                paint(i);
                                if (armed) haptic('select');
                            }, { root: stage, threshold: [0.55, 0.8] });
                            scenes.forEach(function (scene) { io.observe(scene); });
                            window.setTimeout(function () { armed = true; }, 500);
                        }
                        pager.addEventListener('click', function (e) {
                            var btn = e.target.closest('button');
                            if (!btn) return;
                            var i = +btn.getAttribute('data-i');
                            if (!scenes[i]) return;
                            skipUntil = Date.now() + 800;
                            paint(i);
                            alignStage(scenes[i]);
                            syncSceneSoon();
                            haptic('select', btn);
                        });
                    }
                    if (peek) {
                        peek.hidden = !passScene;
                        if (passScene) {
                            var tapX = 0;
                            var tapY = 0;
                            var openedAt = 0;
                            function openPass(e) {
                                if (e) e.preventDefault();
                                var now = Date.now();
                                if (now - openedAt < 400) return;
                                openedAt = now;
                                showPass();
                            }
                            peek.addEventListener('pointerdown', function (e) {
                                tapX = e.clientX;
                                tapY = e.clientY;
                            });
                            peek.addEventListener('pointerup', function (e) {
                                if (Math.abs(e.clientX - tapX) > 12 || Math.abs(e.clientY - tapY) > 12) return;
                                openPass(e);
                            });
                            peek.addEventListener('click', openPass);
                        }
                    }

                    if (!reduceMotion) bindTilt();
                    bindPresent();
                    if (!reduceMotion) bindAmbient();

                    document.addEventListener('pointerdown', function (e) {
                        var el = e.target.closest('.cta, .chip, .btn, .action, .mini, .pass-peek, .install__btn, .pcard, .ncard, .rtype, .ev, .filter');
                        if (!el || el.closest('.tabbar') || el.closest('.pager')) return;
                        haptic(el.classList.contains('cta') ? 'impact' : 'soft', el);
                    }, true);

                    if (document.querySelector('#tab-home .flash')) haptic('success');
                    window.addEventListener('resize', function () { fitStage(); positionPill(); });
                }

                function bindTilt() {
                    var nodes = [].slice.call(document.querySelectorAll('#homeStage .card, #homeStage .pass'));
                    if (!nodes.length) return;
                    var items = nodes.map(function (el) {
                        return { el: el, tx: 0, ty: 0, x: 0, y: 0, gx: 50, gy: 18, tgx: 42, tgy: 16, scale: 1, tscale: 1, held: false };
                    });
                    var gx = 0;
                    var gy = 0;
                    var running = false;
                    function kick() { if (!running) { running = true; window.requestAnimationFrame(loop); } }
                    window.Zeta._kick = kick;
                    function loop() {
                        var alive = false;
