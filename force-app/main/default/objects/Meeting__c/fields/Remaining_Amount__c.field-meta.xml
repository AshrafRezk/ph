<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Remaining_Amount__c</fullName>
    <description>Amount still owed: actual cost when entered, otherwise the deposit, minus payments.</description>
    <formula>IF(NOT(ISBLANK(Actual_Cost__c)), Actual_Cost__c, BLANKVALUE(Deposit_Amount__c, 0)) - BLANKVALUE(Paid_Amount__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Remaining Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
