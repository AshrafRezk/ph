<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One approval step in a department chain, optionally only for some meeting types. When any active record exists, these replace the Meeting Approval Rule metadata. Managed from Admin Console > Meetings Setup.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Read</externalSharingModel>
    <label>Meeting Approval Level</label>
    <nameField>
        <displayFormat>MAL-{0000}</displayFormat>
        <label>Level Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Meeting Approval Levels</pluralLabel>
    <sharingModel>Read</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
