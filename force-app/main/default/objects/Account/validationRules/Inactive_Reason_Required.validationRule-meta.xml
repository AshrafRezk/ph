<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Inactive_Reason_Required</fullName>
    <active>true</active>
    <description>Inactive accounts must have an inactive reason.</description>
    <errorConditionFormula>AND(
  ISPICKVAL(Account_Stage__c, &quot;Inactive&quot;),
  ISBLANK(TEXT(Inactive_Reason__c))
)</errorConditionFormula>
    <errorDisplayField>Inactive_Reason__c</errorDisplayField>
    <errorMessage>Choose an inactive reason before setting the account to Inactive.</errorMessage>
</ValidationRule>
