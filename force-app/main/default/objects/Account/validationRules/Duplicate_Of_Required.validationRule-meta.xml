<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Duplicate_Of_Required</fullName>
    <active>true</active>
    <description>Duplicate accounts must point at the original account.</description>
    <errorConditionFormula>AND(
  ISPICKVAL(Account_Stage__c, &quot;Duplicate&quot;),
  ISBLANK(Duplicate_Of__c)
)</errorConditionFormula>
    <errorDisplayField>Duplicate_Of__c</errorDisplayField>
    <errorMessage>Select the original account this record duplicates.</errorMessage>
</ValidationRule>
