<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Geocode_Precision__c</fullName>
    <description>How precise the geocoded location is. Street, Area and Manual locations are placed in a brick. City locations are placed only when they sit well inside one brick region. Governorate locations are never placed.</description>
    <inlineHelpText>Street and Area are precise enough to place the client in a brick. City and Governorate are only the town or governorate centre.</inlineHelpText>
    <label>Location Precision</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Street</fullName>
                <default>false</default>
                <label>Street</label>
            </value>
            <value>
                <fullName>Area</fullName>
                <default>false</default>
                <label>Area</label>
            </value>
            <value>
                <fullName>City</fullName>
                <default>false</default>
                <label>City</label>
            </value>
            <value>
                <fullName>Governorate</fullName>
                <default>false</default>
                <label>Governorate</label>
            </value>
            <value>
                <fullName>Manual</fullName>
                <default>false</default>
                <label>Manual</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
