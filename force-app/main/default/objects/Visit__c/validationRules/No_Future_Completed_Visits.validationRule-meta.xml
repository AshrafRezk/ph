<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Future_Completed_Visits</fullName>
    <active>true</active>
    <description>Prevents marking visits as Completed before their scheduled calendar date.</description>
    <errorConditionFormula>AND(
  NOT(BEGINS(Client_Visit_Key__c, &quot;PACKV-&quot;)),
  ISPICKVAL(Status__c, &quot;Completed&quot;),
  DATEVALUE(Start_Date__c) &gt; TODAY()
)</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>A visit cannot be marked Completed before its scheduled date.</errorMessage>
</ValidationRule>
