<?xml version="1.0" encoding="UTF-8"?>
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      Deploy to any org that uses the shared Field APK for Salesforce → FCM push.
      Does NOT include ExtlClntAppPushSettings (FCM service account secret — Setup UI only).
      After push credentials are saved in Setup, set pushByDefault=true on the ECA notification types.
    -->
    <types>
        <members>OSR_Offline_Runtime</members>
        <name>ExternalClientApplication</name>
    </types>
    <types>
        <members>OSR_Offline_Runtime_defaultPolicy</members>
        <name>ExtlClntAppConfigurablePolicies</name>
    </types>
    <types>
        <members>OSR_Offline_Runtime</members>
        <name>ExtlClntAppNotificationSettings</name>
    </types>
    <types>
        <members>Visit_Plan_Submitted_To_Manager</members>
        <members>Time_Off_Submitted_To_Manager</members>
        <members>Coaching_Event_Updated</members>
        <members>Brick_Sales_Increase</members>
        <name>CustomNotificationType</name>
    </types>
    <types>
        <members>NotificationTypeConfig</members>
        <name>NotificationTypeConfig</name>
    </types>
    <version>64.0</version>
</Package>
