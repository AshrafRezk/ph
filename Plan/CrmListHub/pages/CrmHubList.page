    <apex:includeScript value="{!URLFOR($Resource.CrmHubRecordModal)}?v=20260730lookup2" />
    <apex:includeScript value="{!URLFOR($Resource.CrmHubListEngine)}?v=20260721dialogs1" />
    <apex:includeScript value="{!URLFOR($Resource.CrmHubListPage)}?v=20260730greet1" />
    <apex:includeScript value="{!URLFOR($Resource.CrmHubNotifications)}?v=20250712a" />
    <apex:includeScript value="{!URLFOR($Resource.CrmHubCommandCenter)}?v=20260717sonicFix2" />
    <script type="text/javascript">
        /* Force VF remoting stubs into the page catalog (typed + string invokeAction). */
        window.CRM_HUB_REMOTE = {
            fetchHubBriefing: '{!$RemoteAction.CrmHubListController.fetchHubBriefing}',
            fetchHubHomeStats: '{!$RemoteAction.CrmHubHomeController.fetchHubHomeStats}',
            synthesizeHubSpeech: '{!$RemoteAction.CrmHubListController.synthesizeHubSpeech}',
            transcribeHubSpeech: '{!$RemoteAction.CrmHubVoiceSearchController.transcribeHubSpeech}',
            getHubBriefingVoiceStatus: '{!$RemoteAction.CrmHubListController.getHubBriefingVoiceStatus}',
            sonicGetOpportunityListViews: '{!$RemoteAction.CrmHubListController.sonicGetOpportunityListViews}',
            getListViewPrefs: '{!$RemoteAction.CrmHubListController.getListViewPrefs}',
            setPinnedListView: '{!$RemoteAction.CrmHubListController.setPinnedListView}',
            toggleFavoriteListView: '{!$RemoteAction.CrmHubListController.toggleFavoriteListView}'
        };
    </script>

    <html lang="en">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
            <!-- Subset Material Symbols (only glyphs we use) + Cache API warm-up for repeat visits -->
            <link
                rel="preload"
                as="style"
                href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&amp;icon_names=more_vert,check_circle,expand_more,undo,arrow_forward,chevron_left,chevron_right,bolt,celebration&amp;display=block"
            />
            <link
                rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&amp;icon_names=more_vert,check_circle,expand_more,undo,arrow_forward,chevron_left,chevron_right,bolt,celebration&amp;display=block"
            />
            <script type="text/javascript">
                (function () {
                    var CACHE = 'crmhub-m3-icons-v1';
                    var SHEETS = [
                        'https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=more_vert,check_circle,expand_more,undo,arrow_forward,chevron_left,chevron_right,bolt,celebration&display=block'
                    ];
                    function warm() {
                        if (!('caches' in window) || !window.fetch) {
                            return;
                        }
                        caches.open(CACHE).then(function (cache) {
                            SHEETS.forEach(function (sheetUrl) {
                                cache.match(sheetUrl).then(function (hit) {
                                    var req = hit
                                        ? Promise.resolve(hit)
                                        : fetch(sheetUrl, { mode: 'cors', credentials: 'omit' }).then(function (res) {
                                              if (res && res.ok) {
                                                  cache.put(sheetUrl, res.clone());
                                              }
                                              return res;
                                          });
                                    return req.then(function (res) {
                                        if (!res || !res.ok) {
                                            return;
                                        }
                                        return res.text().then(function (css) {
                                            var re = /url\((['"]?)(https:\/\/fonts\.gstatic\.com\/[^)'"]+)\1\)/g;
                                            var m;
                                            while ((m = re.exec(css))) {
                                                (function (fontUrl) {
                                                    cache.match(fontUrl).then(function (fontHit) {
                                                        if (fontHit) {
                                                            return;
                                                        }
                                                        fetch(fontUrl, {
                                                            mode: 'cors',
                                                            credentials: 'omit'
                                                        }).then(function (fontRes) {
                                                            if (fontRes && fontRes.ok) {
                                                                cache.put(fontUrl, fontRes.clone());
                                                            }
                                                        });
                                                    });
                                                })(m[2]);
                                            }
                                        });
                                    });
                                });
                            });
                        });
                    }
                    if (document.readyState === 'complete') {
                        setTimeout(warm, 0);
                    } else {
                        window.addEventListener('load', function () {
                            setTimeout(warm, 0);
                        });
                    }
                })();
            </script>
            <style>
                .material-symbols-outlined {
                    font-family: 'Material Symbols Outlined', sans-serif;
                    font-weight: normal;
                    font-style: normal;
                    line-height: 1;
                    letter-spacing: normal;
                    text-transform: none;
                    display: inline-block;
                    white-space: nowrap;
                    word-wrap: normal;
                    direction: ltr;
                    -webkit-font-smoothing: antialiased;
                    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
                }
                :root {
                    --hub-bg: #f2f2f7;
                    --hub-surface: #ffffff;
                    --hub-text: #1c1c1e;
                    --hub-secondary: #636366;
                    --hub-sep: rgba(60, 60, 67, 0.29);
                    --hub-accent: #007aff;
                    --hub-accent-soft: rgba(0, 122, 255, 0.1);
                    --hub-tab-h: 62px;
                    --hub-radius: 12px;
                    --hub-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
                    --hub-transition: 0.22s cubic-bezier(0.4, 0, 0.2, 1);
                    /* Fill parent at every breakpoint; soft side padding lives on .hub-wrap */
                    --hub-rail-max: 100%;
                }
                @media (prefers-color-scheme: dark) {
                    :root {
                        --hub-bg: #000000;
                        --hub-surface: #1c1c1e;
                        --hub-text: #f2f2f7;
                        --hub-secondary: #8e8e93;
                        --hub-sep: rgba(84, 84, 88, 0.65);
                        --hub-accent: #0a84ff;
                    }
                }
                * {
                    box-sizing: border-box;
                }
                html {
                    height: 100%;
                    height: 100dvh;
                    max-height: 100dvh;
                    overflow: hidden;
                }
