                    flex-direction: column;
                    flex: 1 1 auto;
                    width: 100%;
                    max-width: 100%;
                    min-width: 0;
                    box-sizing: border-box;
                }
                .cc-frame-wrap {
                    position: relative;
                    flex: 1 1 auto;
                    width: 100%;
                    max-width: 100%;
                    min-width: 0;
                    min-height: min(420px, 55vh);
                    border: 0.5px solid var(--hub-sep);
                    border-radius: var(--hub-radius);
                    overflow: hidden;
                    background: var(--hub-surface);
                    box-shadow: var(--hub-shadow);
                    box-sizing: border-box;
                }
                .cc-vf-panel {
                    display: none;
                    flex: 1 1 auto;
                    width: 100%;
                    max-width: 100%;
                    min-width: 0;
                    min-height: min(420px, 55vh);
                    border: 0.5px solid var(--hub-sep);
                    border-radius: var(--hub-radius);
                    overflow: auto;
                    overflow-x: hidden;
                    background: var(--hub-surface);
                    box-shadow: var(--hub-shadow);
                    padding: 0.85rem;
                    box-sizing: border-box;
