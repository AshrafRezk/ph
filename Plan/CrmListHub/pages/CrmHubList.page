<apex:page controller="CrmHubListController"
    extensions="CloudastickSonicController,CrmHubVoiceSearchController,CrmHubHomeController"
    showHeader="false"
    sidebar="false"
    docType="html-5.0"
    standardStylesheets="true"
    cache="false"
    applyHtmlTag="false"
    applyBodyTag="false"
>
    <apex:slds />
