                        font-size: 0.72rem;
                    }
                    .cc-subnav-btn {
                        font-size: 0.68rem;
                        padding: 0.32rem 0.6rem;
                    }
                    .cc-vf-panel {
                        padding: 0.7rem;
                        min-height: min(360px, 50vh);
                    }
                    .cc-frame-wrap,
                    .cc-iframe {
                        min-height: min(360px, 50vh);
                    }
                }
                @media (prefers-color-scheme: dark) {
                    .cc-loading {
                        background: rgba(28, 28, 30, 0.82);
