                    margin: 0;
                    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', system-ui, sans-serif;
                    background: var(--hub-bg);
                    color: var(--hub-text);
                    padding-bottom: calc(var(--hub-tab-h) + env(safe-area-inset-bottom, 0px));
                    overflow: hidden;
                    height: 100%;
                    height: 100dvh;
                    max-height: 100dvh;
                    display: flex;
                    flex-direction: column;
                    box-sizing: border-box;
                }
                .hub-wrap {
                    width: 100%;
                    max-width: var(--hub-rail-max);
                    margin: 0 auto;
                    overflow: hidden;
                    min-width: 0;
                    flex: 1 1 0;
                    min-height: 0;
                    display: flex;
                    flex-direction: column;
                    padding: 0.75rem 0.65rem 0.35rem;
                    padding-top: max(0.75rem, env(safe-area-inset-top, 0px));
                    padding-left: max(0.65rem, env(safe-area-inset-left));
                    padding-right: max(0.65rem, env(safe-area-inset-right));
                    box-sizing: border-box;
                }
                /* Desktop: tighter gutters (fill parent, not a content width cap) */
                @media (min-width: 1024px) {
                    .hub-wrap {
                        padding-left: max(0.75rem, env(safe-area-inset-left));
                        padding-right: max(0.75rem, env(safe-area-inset-right));
                    }
                }
                .hub-wrap form {
                    width: 100%;
                    max-width: 100%;
                    min-width: 0;
                    flex: 1 1 0;
                    min-height: 0;
                    display: flex;
                    flex-direction: column;
                    overflow: hidden;
                }
                .hub-header {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    margin-bottom: 0.35rem;
                    min-height: 42px;
                    flex: 0 0 auto;
                }
