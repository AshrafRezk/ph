<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lock_Visit_When_Completed</fullName>
    <active>true</active>
    <description>Prevent editing completed visits</description>
    <errorConditionFormula>AND(
    ISPICKVAL(PRIORVALUE(Status__c), &quot;Completed&quot;),
    NOT(Bypass_Visit_Validation__c),
    NOT($Profile.Name = &quot;System Administrator&quot;)
)</errorConditionFormula>
    <errorMessage>This visit is completed and cannot be edited</errorMessage>
</ValidationRule>
