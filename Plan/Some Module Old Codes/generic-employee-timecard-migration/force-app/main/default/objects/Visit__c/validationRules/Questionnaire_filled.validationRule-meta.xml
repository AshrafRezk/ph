<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Questionnaire_filled</fullName>
    <active>true</active>
    <errorConditionFormula>AND 
( ISPICKVAL(Status__c,&apos;Completed&apos;), !Questionnaire_Filled__c 
)</errorConditionFormula>
    <errorMessage>Please fill questionnaire</errorMessage>
</ValidationRule>
