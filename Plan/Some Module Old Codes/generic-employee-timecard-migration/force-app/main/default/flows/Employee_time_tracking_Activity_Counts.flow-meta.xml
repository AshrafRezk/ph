    <formulas>
        <name>AutomatedRecProperTimeZoneDisplacement</name>
        <dataType>Number</dataType>
        <expression>IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Asia/Dubai&quot;),-4/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Asia/Muscat&quot;),-4/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Asia/Qatar&quot;),-3/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Asia/Riyadh&quot;),-3/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Asia/Bahrain&quot;),-3/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Asia/Kuwait&quot;),-3/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Asia/Baghdad&quot;),-3/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Africa/Cairo&quot;),-2/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Africa/Khartoum&quot;),-2/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Asia/Beirut&quot;),
IF(CONTAINS({!AutoProcessTimeZone.Label},&apos;(GMT+03:00)&apos;),-3/24,-2/24),
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Asia/Amman&quot;),
IF(CONTAINS({!AutoProcessTimeZone.Label},&apos;(GMT+03:00)&apos;),-3/24,-2/24),
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Africa/Tunis&quot;),-1/24,
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Africa/Casablanca&quot;),
IF(CONTAINS({!AutoProcessTimeZone.Label},&apos;(GMT+01:00)&apos;),-1/24,0),
IF(ISPICKVAL({!DayCard.Employee_Time_Card__r.CreatedBy.TimeZoneSidKey},&quot;Africa/Algiers&quot;),-1/24,
0
))))))))))))))</expression>
        <scale>3</scale>
