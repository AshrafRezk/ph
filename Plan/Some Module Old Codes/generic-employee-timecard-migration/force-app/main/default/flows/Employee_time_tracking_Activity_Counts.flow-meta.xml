    NOT(ISBLANK(TEXT({!Visits_Processing.Account__r.AccountType__c}))),
    NOT(ISPICKVAL({!Visits_Processing.Account__r.AccountType__c}, &quot;Dr Lead&quot;)),
    {!Visits_Processing.Assigned_To__c} = {!U.Id}
  ),
  1,
  0
)</expression>
