    <formulas>
        <name>DayEntryDefinitionFormula</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!WEDaysAtHand}, {!DayEntryNameFormula}),&quot;Weekend Day&quot;,&quot;Weekday&quot;)</expression>
    </formulas>
    <formulas>
        <name>DayEntryFormula</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!StartDate_frm}),MONTH({!StartDate_frm}),{!DaysCounter})</expression>
    </formulas>
    <formulas>
        <name>DayEntryNameFormula</name>
        <dataType>String</dataType>
        <expression>IF(WEEKDAY({!DayEntryFormula})=1,&quot;Sunday&quot;,
IF(WEEKDAY({!DayEntryFormula})=2,&quot;Monday&quot;,
IF(WEEKDAY({!DayEntryFormula})=3,&quot;Tuesday&quot;,
IF(WEEKDAY({!DayEntryFormula})=4,&quot;Wednesday&quot;,
IF(WEEKDAY({!DayEntryFormula})=5,&quot;Thursday&quot;,
IF(WEEKDAY({!DayEntryFormula})=6,&quot;Friday&quot;,&quot;Saturday&quot;))))))</expression>
    </formulas>
    <formulas>
        <name>DaysThisMonth</name>
        <dataType>Number</dataType>
        <expression>DAY({!EndDate_frm})</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>EndDate_frm</name>
        <dataType>Date</dataType>
        <expression>IF(
  MONTH({!TheReferenceDate}) = 12,
  DATE( YEAR({!TheReferenceDate}), 12, 31 ),
  DATE( YEAR( {!TheReferenceDate}), MONTH ({!TheReferenceDate}) + 1, 1 ) - 1 
)</expression>
    </formulas>
    <formulas>
        <name>StartDate_frm</name>
        <dataType>Date</dataType>
        <expression>DATE(YEAR({!TheReferenceDate}),MONTH({!TheReferenceDate}),1)</expression>
    </formulas>
    <formulas>
        <name>TheReferenceDate</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate}</expression>
    </formulas>
