# Copy to offline/.env (gitignored) for local Vite.

# Optional local Vite /services proxy target. Leave empty for production builds —
# the login form does not prefill a company My Domain from this.
# Example: VITE_SF_INSTANCE_URL=https://yourcompany.my.salesforce.com
VITE_SF_INSTANCE_URL=

# Connected App consumer key (public). Never put the consumer secret in VITE_*.
VITE_SF_CLIENT_ID=

# Defaults; the login form can still pick Live / Practice / Company My Domain.
VITE_SF_LOGIN_URL=https://login.salesforce.com

# Native Capacitor deep link (must match capacitor.config.ts appId scheme).
VITE_SF_REDIRECT_URI=com.yourapp.fieldpwa://oauth/callback

# Production web only — leave unset for local HTTPS Vite
# (app uses https://localhost:<port>/oauth/callback with @vitejs/plugin-basic-ssl).
VITE_SF_WEB_REDIRECT_URI=https://www.salesforceoffline.com/oauth/callback

# Optional Netlify function-only (never VITE_): SF_CLIENT_SECRET
# Only if the Connected App still requires a secret. Prefer PKCE public client
# with isConsumerSecretOptional=true (OSR Offline Runtime Connected App).
